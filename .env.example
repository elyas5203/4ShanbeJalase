# ===============================================
# SaaS Subscription Manager Configuration
# ===============================================

# Port to bind backend service
PORT=8000

# Database Connection (Default SQLite file inside data volume, or PostgreSQL)
DATABASE_URL=sqlite:////app/data/saas.db
# For Postgres: postgresql://username:password@localhost:5432/saas_db

# Admin Panel Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_strong_password_change_me
ADMIN_SECRET_KEY=super_secret_jwt_key_random_string_here

# Telegram Bot
# Get from @BotFather
TELEGRAM_BOT_TOKEN=

# Bale Messenger Bot
# Get from @BotFather in Bale
BALE_BOT_TOKEN=

# Admin Telegram Chat ID (where purchase alerts and expiry notifications are sent)
ADMIN_TELEGRAM_CHAT_ID=

# PayPing Payment Gateway
# PayPing Authorization Token
PAYPING_TOKEN=
# Public Return URL after user finishes payment
PAYPING_RETURN_URL=https://YOUR_PUBLIC_HTTPS_DOMAIN/api/payment/callback

# Operational Modes
TEST_MODE=false
