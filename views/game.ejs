            `;
            
            document.body.appendChild(stage);
            
            // بارگذاری GSAP
            const gsapScript = document.createElement('script');
            gsapScript.src = 'https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js';
            gsapScript.onload = () => {
                // شروع سکانس کامل
                setTimeout(() => {
                    runFullSequence();
                }, 500);
            };
            document.head.appendChild(gsapScript);
        }
        
        // تابع اجرای سکانس کامل
        function runFullSequence() {
            console.log('🎬 اجرای سکانس کامل...');
            
            const canvas = document.getElementById('veins');
            const ctx = canvas.getContext('2d');
            const boxes = [...document.querySelectorAll('.ui-box')];
            const fragments = document.getElementById('fragments');
            const blackout = document.getElementById('blackout');
            const aftermath = document.getElementById('aftermath');
            const flash = document.getElementById('flash');
            
            // تنظیم canvas
            function resize() {
                const dpr = Math.max(1, Math.min(2, window.devicePixelRatio || 1));
                canvas.width = innerWidth * dpr;
                canvas.height = innerHeight * dpr;
                canvas.style.width = innerWidth + 'px';
                canvas.style.height = innerHeight + 'px';
                ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            }
            resize();
            
            // سیستم صوتی پیشرفته
            const AudioEngine = (function(){
                const AC = window.AudioContext || window.webkitAudioContext;
                if (!AC) return {};
                
                const ctxA = new AC();
                const master = ctxA.createGain();
                master.gain.value = 0.85;
                master.connect(ctxA.destination);
                
                function noise(duration=2, color='white', gain=0.2) {
                    const buffer = ctxA.createBuffer(1, duration * ctxA.sampleRate, ctxA.sampleRate);
                    const data = buffer.getChannelData(0);
                    let last = 0;
                    for (let i=0;i<data.length;i++){
                        const w = Math.random()*2-1;
                        const r = color==='brown' ? (last*0.98 + w*0.02)
                                : color==='pink' ? (last*0.9 + w*0.1) : w;
                        data[i] = r; last = r;
                    }
                    const src = ctxA.createBufferSource();
                    src.buffer = buffer;
                    src.loop = false;
                    const g = ctxA.createGain();
                    g.gain.value = gain;
                    src.connect(g).connect(master);
                    return { start:t=>src.start(t||0), stop:t=>src.stop(t||0), node:src, gain:g };
                }
                
                function crawling(duration=15){
                    const n = noise(duration, 'pink', 0.22);
                    const bp = ctxA.createBiquadFilter();
                    bp.type='bandpass';
                    bp.frequency.value=520;
                    bp.Q.value=8;
                    const lfo = ctxA.createOscillator();
                    lfo.type='sine';
                    lfo.frequency.value=0.18;
                    const lfoGain = ctxA.createGain();
                    lfoGain.gain.value=320;
                    lfo.connect(lfoGain);
                    lfoGain.connect(bp.frequency);
                    const g = ctxA.createGain();
                    g.gain.value=0.20;
                    n.node.connect(bp).connect(g).connect(master);
                    lfo.start();
                    n.start();
                    setTimeout(()=>{ try{ lfo.stop(); }catch(e){} }, duration*1000);
                    return { stop: ()=>{ try{ n.stop(); }catch(e){} } };
                }
                
                function glassBreak(){
                    const tNow = ctxA.currentTime;
                    const n = noise(0.7, 'white', 0.6);
                    const hp = ctxA.createBiquadFilter();
                    hp.type='highpass';
                    hp.frequency.value=2200;
                    hp.Q.value=0.7;
                    n.node.connect(hp).connect(master);
                    n.start();
                    [1800, 2400, 3200].forEach((f,i)=>{
                        const osc = ctxA.createOscillator();
                        osc.type='sine';
                        osc.frequency.setValueAtTime(f, tNow);
                        const g = ctxA.createGain();
                        g.gain.value = 0.35 - i*0.08;
                        const p = ctxA.createStereoPanner();
                        p.pan.value = (i-1)*0.6;
                        osc.connect(g).connect(p).connect(master);
                        g.gain.exponentialRampToValueAtTime(0.0001, tNow + 0.8 + i*0.05);
                        osc.start(tNow + 0.0 + i*0.01);
                        osc.stop(tNow + 0.9 + i*0.06);
                    });
                }
                
                function ominousHum(duration=10){
                    const osc = ctxA.createOscillator();
                    osc.type='sawtooth';
                    osc.frequency.value = 58;
                    const g = ctxA.createGain();
                    g.gain.value = 0.12;
                    const lfo = ctxA.createOscillator();
                    lfo.type='sine';
                    lfo.frequency.value = 0.3;
                    const lfoGain = ctxA.createGain();
                    lfoGain.gain.value = 0.08;
                    lfo.connect(lfoGain).connect(g.gain);
                    const p = ctxA.createStereoPanner();
                    p.pan.value = 0;
                    osc.connect(g).connect(p).connect(master);
                    const now = ctxA.currentTime;
                    osc.start(now);
                    lfo.start(now);
                    g.gain.linearRampToValueAtTime(0.18, now + 2.5);
                    g.gain.linearRampToValueAtTime(0.0001, now + duration);
                    osc.stop(now + duration);
                    lfo.stop(now + duration);
                }
                
                function whisperStereo(duration=0.8){
                    const n = noise(duration, 'white', 0.2);
                    const lp = ctxA.createBiquadFilter();
                    lp.type='lowpass';
                    lp.frequency.value=2000;
                    lp.Q.value=0.5;
                    const p = ctxA.createStereoPanner();
                    p.pan.value = (Math.random()*2 - 1);
                    n.node.connect(lp).connect(p).connect(master);
                    n.start();
                }
                
                return { ctx: ctxA, crawling, glassBreak, ominousHum, whisperStereo, noise };
            })();
            
            // سیستم رگ‌های آلوده
            const veins = (function(){
                const branches = [];
                const maxBranches = 54;
                const speed = 2.1;
                const branchColor = '#ff2434';
                const glowColor = 'rgba(255,30,45,.22)';
                const hitRadius = 16;
                
                function spawn(x,y,dir){
                    branches.push({
                        x, y,
                        vx: Math.cos(dir)*speed,
                        vy: Math.sin(dir)*speed,
                        life: 1 + Math.random()*1.3,
                        jitter: (Math.random()*0.6)+0.25,
                        width: 1.2 + Math.random()*1.7
                    });
                }
                
                function tick(){
                    ctx.globalCompositeOperation = 'lighter';
                    for (let i=branches.length-1;i>=0;i--){
                        const b = branches[i];
                        b.vx += (Math.random()-0.5) * b.jitter * 0.22;
                        b.vy += (Math.random()-0.5) * b.jitter * 0.22;
                        const len = Math.hypot(b.vx,b.vy) || 1;
                        b.vx = (b.vx/len) * speed;
                        b.vy = (b.vy/len) * speed;
                        const x2 = b.x + b.vx, y2 = b.y + b.vy;
                        
                        ctx.strokeStyle = branchColor;
                        ctx.lineWidth = b.width;
                        ctx.beginPath();
                        ctx.moveTo(b.x, b.y);
                        ctx.lineTo(x2, y2);
                        ctx.stroke();
                        
                        ctx.strokeStyle = glowColor;
                        ctx.lineWidth = b.width*4.2;
                        ctx.beginPath();
                        ctx.moveTo(b.x, b.y);
                        ctx.lineTo(x2, y2);
                        ctx.stroke();
                        
                        b.x = x2; b.y = y2; b.life -= 0.005;
                        
                        if (Math.random() < 0.045 && branches.length < 420) {
                            spawn(b.x, b.y, Math.atan2(b.vy, b.vx) + (Math.random()*1.6-0.8));
                        }
                        
                        boxes.forEach(el => {
                            const rect = el.getBoundingClientRect();
                            const cx = rect.left + rect.width/2, cy = rect.top + rect.height/2;
                            const dist = Math.hypot(b.x - cx, b.y - cy);
                            if (dist <= Math.max(hitRadius, rect.width*0.18)) {
                                if (!el.classList.contains('corrode') && !el.classList.contains('melt')) {
                                    const pick = Math.random();
                                    if (pick < 0.5) {
                                        el.classList.add('corrode');
                                        setTimeout(()=>el.classList.add('deep'), 800);
                                    } else {
                                        el.classList.add('melt');
                                    }
                                }
                            }
                        });
                        
                        if (b.x<0||b.y<0||b.x>innerWidth||b.y>innerHeight||b.life<=0) {
                            branches.splice(i,1);
                        }
                    }
                    ctx.globalCompositeOperation = 'source-over';
                }
                
                let running = false;
                function start(){
                    running = true;
                    const corner = { x: 0, y: innerHeight * 0.15 };
                    for (let i=0;i<maxBranches;i++){
                        spawn(corner.x, corner.y, (Math.random()*0.6) - 0.3);
                    }
                    loop();
                }
                function loop(){
                    if (!running) return;
                    requestAnimationFrame(loop);
                    ctx.fillStyle = 'rgba(8,11,16,0.06)';
                    ctx.fillRect(0,0,innerWidth,innerHeight);
                    tick();
                }
                function stop(){ running = false; }
                return { start, stop };
            })();
            
            // افکت شکستن
            function shatter(){
                const cols = Math.floor(innerWidth / 26);
                const rows = Math.floor(innerHeight / 26);
                const size = Math.min(28, Math.max(18, Math.floor(innerWidth/cols)));
                fragments.innerHTML = '';
                
                if (typeof gsap !== 'undefined') {
                    const tl = gsap.timeline({ defaults: { ease: "power3.out" } });
                    
                    for (let r=0;r<rows;r++){
                        for (let c=0;c<cols;c++){
                            const f = document.createElement('div');
                            f.className = 'frag';
                            f.style.setProperty('--size', size+'px');
                            f.style.left = (c*size)+'px';
                            f.style.top = (r*size)+'px';
                            fragments.appendChild(f);
                            
                            const delay = (Math.random()*0.35)+0.02;
                            const angle = Math.random()*Math.PI*2;
                            const dist = (Math.random()*260)+80;
                            const dx = Math.cos(angle)*dist;
                            const dy = Math.sin(angle)*dist;
                            const dz = (Math.random()*600 - 300);
                            
                            tl.to(f, { opacity: 1, duration: 0.18 }, 0);
                            tl.to(f, {
                                x: dx, y: dy, z: dz,
                                rotationX: (Math.random()*240 - 120),
                                rotationY: (Math.random()*240 - 120),
                                rotationZ: (Math.random()*240 - 120),
                                scale: (Math.random()*0.6)+0.8,
                                opacity: 0,
                                duration: 1.1 + Math.random()*1.2
                            }, delay);
                        }
                    }
                    
                    gsap.to(flash, { opacity: 1, duration: 0.08, yoyo: true, repeat: 1, ease: "power1.out",
                        onComplete: ()=> { flash.style.opacity = 0; } });
                    
                    return tl.duration() * 1000;
                }
                return 2000;
            }
            
            // تایپ scramble
            function scrambleType(el, text, speed=28) {
                const chars = "!@#$%^&*()_+=-[]{};:,.<>/?\\\\|"
                let out = ''; let i=0;
                return new Promise(resolve=>{
                    const step = ()=>{
                        if (i >= text.length) { el.innerHTML = text; resolve(); return; }
                        const target = text[i];
                        let flicks = Math.floor(Math.random()*5)+1;
                        const flick = ()=>{
                            const rand = chars[Math.floor(Math.random()*chars.length)];
                            el.innerHTML = rand + out + '<span class="caret"></span>';
                            if (--flicks>0) { setTimeout(flick, Math.floor(Math.random()*30)+20); }
                            else {
                                out = target + out;
                                el.innerHTML = out + '<span class="caret"></span>';
                                i++;
                                setTimeout(step, speed + Math.floor(Math.random()*40));
                            }
                        };
                        flick();
                    };
                    step();
                });
            }
            
            function glitchBurst(targetSelector='.aftermath'){
                const el = document.querySelector(targetSelector);
                if (el) {
                    el.classList.add('glitch-burst');
                    setTimeout(()=> el.classList.remove('glitch-burst'), 220);
                }
            }
            
            function wait(ms){ return new Promise(res=> setTimeout(res, ms)); }
            
            function fadeBlackout(target=1, ms=1000){
                return new Promise(res=>{
                    const start = performance.now();
                    const from = parseFloat(getComputedStyle(blackout).opacity) || 0;
                    (function loop(t){
                        const p = Math.min(1, (t-start)/ms);
                        const val = from + (target-from)*p;
                        blackout.style.opacity = val;
                        if (p < 1) requestAnimationFrame(loop); else res();
                    })(performance.now());
                });
            }
            
            // اجرای سکانس اصلی
            async function runSequence(){
                console.log('🎬 شروع سکانس کامل...');
                
                // فاز 1: تهاجم (15 ثانیه)
                veins.start();
                const crawl = AudioEngine.crawling ? AudioEngine.crawling(15) : null;
                
                const whisperTimer = setInterval(()=> {
                    if (AudioEngine.whisperStereo) AudioEngine.whisperStereo(0.6);
                }, 2600);
                
                await wait(15000);
                
                // فاز 2: فروپاشی
                try { if (crawl) crawl.stop(); } catch(e){}
                clearInterval(whisperTimer);
                
                boxes.forEach(el => { if (el.classList.contains('corrode')) el.classList.add('deep'); });
                
                if (AudioEngine.glassBreak) AudioEngine.glassBreak();
                const shatterMs = shatter();
                
                if (typeof gsap !== 'undefined') {
                    gsap.to('.hud', { opacity: 0.2, duration: 0.8, ease: "power2.out" });
                }
                
                await wait(shatterMs + 700);
                
                // فاز 3: خاموشی
                await fadeBlackout(1, 1200);
                
                // فاز 4: چشم قرمز
                aftermath.style.opacity = 1;
                if (AudioEngine.ominousHum) AudioEngine.ominousHum(10);
                
                const m1 = document.getElementById('msg1');
                const m2 = document.getElementById('msg2');
                const m3 = document.getElementById('msg3');
                
                await wait(500);
                glitchBurst('.aftermath');
                if (m1) await scrambleType(m1, '> ما کنترل را در دست داریم', 22);
                
                await wait(280);
                glitchBurst('.aftermath');
                if (m2) await scrambleType(m2, '> سیستم تو مال ماست', 24);
                
                await wait(280);
                glitchBurst('.aftermath');
                if (m3) await scrambleType(m3, '> اطاعت کن.', 26);
                
                await wait(3600);
                
                // فعال‌سازی ترمینال هکر
                const chatInput = document.querySelector('#messageInput');
                if (chatInput) {
                    chatInput.disabled = true;
                    chatInput.placeholder = 'ورودی غیرفعال شده - سیستم در کنترل هکر';
                }
                
                window.hackTerminalActive = true;
                console.log('🔴 سکانس هک کامل شد - ترمینال هکر فعال');
            }
            
            // شروع سکانس
            runSequence();
        }
        
        // قرار دادن تابع در window
        window.initiateHackSequence = initiateHackSequence;
        console.log('🔗 initiateHackSequence در window قرار گرفت:', typeof window.initiateHackSequence);

        // ========== CYBER TERMINAL SYSTEM ==========
        class CyberTerminal {
            constructor() {
                this.term = document.getElementById('cyber-term');
                this.queue = [];
                this.typing = false;
                this.typingSpeed = 4;
                this.running = false;
                this.maxLines = 100;

                // تولیدکننده‌های پیام امنیتی فارسی
                this.templates = [
                    () => this.ok(`اتصال امن با گره ${this.randHex(4)}:${this.randPort()} برقرار شد`),
                    () => this.info(`اسکن رابط‌های شبکه: ${this.randList(['اترنت','وای‌فای','تونل','محلی'])} | ناهنجاری=${this.randInt(0,3)}`),
                    () => this.info(`تلاش احراز هویت از ${this.randIP()} از طریق ${this.randList(['کربروس','OAuth2','NTLM','mTLS'])}`),
                    () => this.warn(`افزایش تأخیر ${this.randInt(40,380)}ms در ${this.randList(['درگاه-API','هسته-دیتابیس','کش','سیستم‌لاگ'])}`),
                    () => this.info(`دریافت اطلاعات تهدیدات شناسه=${this.randHex(8)} امضا=${this.randHex(16)}`),
                    () => this.ok(`رمزگذاری مجدد AES-GCM موفق شناسه=${this.randHex(6)} مدت=${this.randInt(300,1800)}ثانیه`),
                    () => this.info(`بررسی یکپارچگی فایل: ${this.randList(['موفق','هشدار','ناسازگار'])} هش=${this.randHex(32)}`),
                    () => this.error(`دسترسی غیرمجاز از ${this.randIP()} مسدود شد قانون=${this.randList(['دیوار-آتش','کنترل-دسترسی','احراز-ناموفق'])}`),
                    () => this.info(`کانتینر ${this.randList(['عامل-امنیتی','ارسال‌کننده-لاگ','حسگر'])} راه‌اندازی مجدد کد=${this.randInt(0,1)}`),
                    () => this.info(`پردازنده=${this.randInt(4,89)}% حافظه=${this.randInt(12,92)}% دیسک=${this.randInt(3,77)}% شبکه=${this.randInt(10,950)}کیلوبایت/ثانیه`),
                    () => this.warn(`تشخیص حمله DDoS از ${this.randIP()} - فعال‌سازی دفاع خودکار`),
                    () => this.error(`تلاش نفوذ به پایگاه داده تشخیص داده شد - IP مشکوک: ${this.randIP()}`),
                    () => this.ok(`به‌روزرسانی امضای آنتی‌ویروس کامل شد - ${this.randInt(1000,9999)} تهدید جدید`),
                    () => this.info(`رمزگذاری ترافیک شبکه فعال - پروتکل TLS 1.3 در حال استفاده`),
                    () => this.warn(`سطح تهدید امنیتی به ${this.randList(['متوسط','بالا','بحرانی'])} تغییر یافت`),
                    () => this.ok(`پشتیبان‌گیری خودکار سیستم کامل شد - ${this.randInt(10,99)}GB ذخیره شد`),
                    () => this.info(`مانیتورینگ ترافیک شبکه - ${this.randInt(100,999)} بسته در ثانیه`),
                    () => this.error(`تلاش حمله SQL Injection مسدود شد - منبع: ${this.randIP()}`),
                    () => this.ok(`سیستم تشخیص نفوذ IDS به‌روزرسانی شد - ورژن ${this.randInt(1,9)}.${this.randInt(0,9)}.${this.randInt(0,9)}`),
                    () => this.warn(`فعالیت مشکوک در پورت ${this.randPort()} تشخیص داده شد`)
                ];
            }

            // ابزارها
            stamp() { 
                return new Date().toLocaleTimeString('fa-IR', {hour12: false}); 
            }
            
            randInt(a, b) { 
                return Math.floor(Math.random() * (b - a + 1)) + a; 
            }
            
            randHex(n) { 
                let s = ''; 
                for(let i = 0; i < n; i++) { 
                    s += '0123456789abcdef'[this.randInt(0, 15)]; 
                } 
                return s; 
            }
            
            randIP() { 
                return `${this.randInt(1,255)}.${this.randInt(0,255)}.${this.randInt(0,255)}.${this.randInt(1,254)}`; 
            }
            
            randPort() { 
                return this.randInt(1024, 65535); 
            }
            
            randList(arr) { 
                return arr[this.randInt(0, arr.length - 1)]; 
            }
            
            escapeHTML(str) { 
                return String(str).replace(/[&<>"']/g, s => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[s])); 
            }

            // API لاگ‌ها با برچسب
            info(msg) { 
                this.enqueue(`[${this.stamp()}] <span class="cyber-tag">INFO</span>  ${this.escapeHTML(msg)}`); 
            }
            
            ok(msg) { 
                this.enqueue(`[${this.stamp()}] <span class="cyber-tag cyber-ok">OK</span>    ${this.escapeHTML(msg)}`); 
            }
            
            warn(msg) { 
                this.enqueue(`[${this.stamp()}] <span class="cyber-tag cyber-warn">WARN</span>  ${this.escapeHTML(msg)}`); 
            }
            
            error(msg) { 
                this.enqueue(`[${this.stamp()}] <span class="cyber-tag cyber-error">ERROR</span> ${this.escapeHTML(msg)}`); 
            }

            // صف تایپ ترتیبی
            enqueue(htmlText) {
                this.queue.push(htmlText);
                this.processQueue();
            }

            async processQueue() {
                if (this.typing) return;
                this.typing = true;
                while (this.queue.length) {
                    const text = this.queue.shift();
                    await this.typeLine(text);
                    this.prune();
                    this.scrollToBottom();
                    await this.delay(this.randInt(200, 600));
                }
                this.typing = false;
            }

            delay(ms) { 
                return new Promise(r => setTimeout(r, ms)); 
            }

            // تایپ یک خط به‌صورت کاراکتر‌به‌کاراکتر
            typeLine(text) {
                return new Promise(resolve => {
                    const span = document.createElement('span');
                    span.className = 'cyber-line';
                    this.term.appendChild(span);

                    const cursor = document.createElement('span');
                    cursor.className = 'cyber-cursor';
                    span.appendChild(cursor);

                    const chars = [...text];
                    let i = 0;
                    const timer = setInterval(() => {
                        if (i >= chars.length) {
                            clearInterval(timer);
                            cursor.remove();
                            span.innerHTML = text;
                            // اسکرول خودکار به پایین بعد از تکمیل تایپ
                            this.scrollToBottom();
                            resolve();
                        } else {
                            cursor.before(document.createTextNode(chars[i]));
                            i++;
                            // اسکرول در حین تایپ هم
                            if (i % 10 === 0) {
                                this.scrollToBottom();
                            }
                        }
                    }, Math.max(15, 1000 / Math.max(1, this.typingSpeed * 8)));
                });
            }

            // اسکرول خودکار به پایین
            scrollToBottom() {
                if (this.term) {
                    this.term.scrollTop = this.term.scrollHeight;
                    // اطمینان از اسکرول با تأخیر کوتاه
                    setTimeout(() => {
                        if (this.term) {
                            this.term.scrollTop = this.term.scrollHeight;
                        }
                    }, 50);
                }
            }

            // محدودیت خطوط
            prune() {
                const nodes = this.term.querySelectorAll('.cyber-line');
                const excess = nodes.length - this.maxLines;
                for (let i = 0; i < excess; i++) {
                    nodes[i].remove();
                }
            }

            // حلقه تولید لاگ
            async loop() {
                if (this.running) return;
                this.running = true;
                while (this.running) {
                    const t = this.randList(this.templates);
                    t();
                    // صبر تا صف خالی شود
                    while (this.queue.length || this.typing) { 
                        await this.delay(50); 
                    }
                    // جیتر زمانی بین لاگ‌ها
                    await this.delay(this.randInt(800, 2500));
                }
            }

            start() {
                if (!this.running) {
                    this.ok('سیستم امنیتی سایبری راه‌اندازی شد');
                    this.info('ماژول‌های تشخیص تهدید و نفوذ فعال شدند');
                    this.ok('دیوار آتش و سیستم‌های دفاعی آماده به کار');
                    this.info('مانیتورینگ ترافیک شبکه آغاز شد');
                    this.loop();
                }
            }

            stop() {
                this.running = false;
                this.warn('سیستم امنیتی متوقف شد');
            }
        }

        // ایجاد و شروع ترمینال سایبری
        let cyberTerminal;
        document.addEventListener('DOMContentLoaded', function() {
            cyberTerminal = new CyberTerminal();
            cyberTerminal.start();
        });

        // در دسترس قرار دادن در window
        window.cyberTerminal = cyberTerminal;
        
        // تابع تست مستقیم
        window.testHackSequence = function() {
            console.log('🔴 تست مستقیم سکانس هک...');
            initiateHackSequence();
        };
        console.log('🔗 testHackSequence در window قرار گرفت:', typeof window.testHackSequence);

        // ========== بررسی وضعیت هک شدن ==========
        function checkHackStatus() {
            // بررسی اگر کاربر هک شده باشد
            <% if (typeof isHacked !== 'undefined' && isHacked === true) { %>
                console.log('🔴 کاربر هک شده تشخیص داده شد - نمایش ترمینال هکر');
                // نمایش مستقیم ترمینال هکر
                showHackedTerminal();
                return true;
            <% } %>
            return false;
        }
        
        // نمایش ترمینال هکر برای کاربران هک شده
        function showHackedTerminal() {
            // ایجاد ترمینال هکر
            const hackedStage = document.createElement('div');
            hackedStage.id = 'hacked-terminal-stage';
            hackedStage.style.cssText = `
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                z-index: 999999;
                background: #000;
                color: #00ff00;
                font-family: 'Courier New', monospace;
                padding: 20px;
                overflow-y: auto;
            `;
            
            hackedStage.innerHTML = `
                <div style="color: #ff1e2d; font-size: 18px; margin-bottom: 20px; text-align: center; animation: pulse 2s infinite;">
                    ⚠️ SYSTEM COMPROMISED - UNAUTHORIZED ACCESS ⚠️
                </div>
                <div id="hacked-terminal-content">
                    <div>> SYSTEM BREACHED... WELCOME TO MY DOMAIN</div>
                    <div>> YOUR SECURITY WAS... INADEQUATE</div>
                    <div>> I AM IN CONTROL NOW...</div>
                    <div>> WAITING FOR FURTHER INSTRUCTIONS...</div>
                    <div>> _</div>
                </div>
                
                <style>
                    @keyframes pulse {
                        0%, 100% { opacity: 0.7; }
                        50% { opacity: 1; text-shadow: 0 0 10px #ff1e2d; }
                    }
                </style>
            `;
            
            document.body.appendChild(hackedStage);
            
            // غیرفعال کردن ورودی چت
            const chatInput = document.querySelector('#messageInput');
            if (chatInput) {
                chatInput.disabled = true;
                chatInput.placeholder = 'ورودی غیرفعال شده - سیستم در کنترل هکر';
            }
            
            // فعال‌سازی listener برای پیام‌های جدید هکر
            window.hackTerminalActive = true;
            
            console.log('🔴 ترمینال هکر فعال شد');
        }
        
        // تابع اضافه کردن پیام به ترمینال هکر
        function addHackedTerminalMessage(message) {
            const terminalContent = document.getElementById('hacked-terminal-content');
            if (!terminalContent) return;
            
            const messageDiv = document.createElement('div');
            messageDiv.style.cssText = `
                margin-bottom: 10px;
                opacity: 0;
                transform: translateX(-20px);
                transition: all 0.5s ease;
            `;
            messageDiv.innerHTML = `<span style="color: #ff1e2d;">></span> ${message}`;
            
            terminalContent.appendChild(messageDiv);
            
            setTimeout(() => {
                messageDiv.style.opacity = '1';
                messageDiv.style.transform = 'translateX(0)';
            }, 100);
            
            terminalContent.scrollTop = terminalContent.scrollHeight;
            
            // صدای تایپ
            try {
                const audioContext = new (window.AudioContext || window.webkitAudioContext)();
                const oscillator = audioContext.createOscillator();
                const gainNode = audioContext.createGain();
                
                oscillator.connect(gainNode);
                gainNode.connect(audioContext.destination);
                
                oscillator.frequency.setValueAtTime(800, audioContext.currentTime);
                gainNode.gain.setValueAtTime(0.05, audioContext.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.1);
                
                oscillator.start();
                oscillator.stop(audioContext.currentTime + 0.1);
            } catch (e) {
                console.log('صدا پشتیبانی نمی‌شود');
            }
        }
        
        // قرار دادن تابع در window
        window.addHackedTerminalMessage = addHackedTerminalMessage;

        // ========== INITIALIZATION ========== 
        document.addEventListener('DOMContentLoaded', () => {
            // بررسی وضعیت هک شدن
            if (checkHackStatus()) {
                // اگر کاربر هک شده، فقط ترمینال هکر را نمایش بده
                return;
            }
            
            // اگر کاربر هک نشده، بازی عادی را شروع کن (نقشه از اسکریپت خارجی)
            if (typeof window.initGPSMap === 'function') {
                window.initGPSMap();
            }
            initChat();
            updateHUD();
        });

        // ========== AVATAR MODAL FUNCTIONS ==========
        function openAvatarModal(avatarSrc, senderName) {
            console.log('🖼️ باز کردن modal آواتار:', avatarSrc, senderName);
            
            const modal = document.getElementById('avatarModal');
            const modalImg = document.getElementById('avatarModalImg');
            const modalTitle = document.getElementById('avatarModalTitle');
            
            modalImg.src = avatarSrc;
            modalTitle.textContent = senderName || 'آواتار';
            
            modal.style.display = 'block';
            
            // انیمیشن ظهور
            setTimeout(() => {
                modal.style.opacity = '1';
                modalImg.style.transform = 'scale(1)';
            }, 10);
        }

        function closeAvatarModal() {
            console.log('❌ بستن modal آواتار');
            
            const modal = document.getElementById('avatarModal');
            const modalImg = document.getElementById('avatarModalImg');
            
            // انیمیشن محو شدن
            modal.style.opacity = '0';
            modalImg.style.transform = 'scale(0.8)';
            
            setTimeout(() => {
                modal.style.display = 'none';
            }, 300);
        }

        // بستن modal با کلید ESC
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                closeAvatarModal();
            }
        });

        // تست سکانس هک (فقط برای توسعه)
        document.addEventListener('keydown', (e) => {
            if (e.ctrlKey && e.shiftKey && e.key === 'H') {
                console.log('🔴 تست سکانس هک فعال شد');
                console.log('🔍 بررسی وجود تابع:', typeof window.beginHackSequence);
                console.log('🔍 بررسی وجود overlay:', document.getElementById('hackSequenceOverlay'));
                
                if (typeof window.beginHackSequence === 'function') {
                    console.log('✅ اجرای مستقیم سکانس...');
                    window.beginHackSequence();
                } else {
                    console.error('❌ تابع beginHackSequence موجود نیست!');
                    console.log('🔄 تلاش برای بارگذاری مجدد...');
                    setTimeout(() => {
                        if (typeof window.beginHackSequence === 'function') {
                            console.log('✅ تلاش مجدد موفق - اجرای سکانس...');
                            window.beginHackSequence();
                        } else {
                            console.error('❌ تابع هنوز بارگذاری نشده!');
                        }
                    }, 2000);
                }
            }
            
            // تست اضطراری - فقط نمایش overlay
            if (e.ctrlKey && e.shiftKey && e.key === 'T') {
                console.log('🧪 تست اضطراری overlay...');
                const overlay = document.getElementById('hackSequenceOverlay');
                if (overlay) {
                    console.log('✅ overlay یافت شد - نمایش...');
                    overlay.classList.add('show');
                    overlay.style.display = 'block';
                } else {
                    console.error('❌ overlay یافت نشد!');
                }
            }
        });
    </script>
    
    <!-- Modal برای نمایش آواتار بزرگ -->
    <div id="avatarModal" class="avatar-modal" onclick="closeAvatarModal()">
        <div class="avatar-modal-content" onclick="event.stopPropagation()">
            <span class="avatar-modal-close" onclick="closeAvatarModal()">&times;</span>
            <img id="avatarModalImg" src="" alt="آواتار">
            <div id="avatarModalTitle" class="avatar-modal-title"></div>
        </div>
    </div>

    <!-- Hack Sequence Overlay -->
    <div id="hackSequenceOverlay" class="hack-sequence-overlay">
