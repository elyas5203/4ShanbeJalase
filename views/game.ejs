    <!-- ماژول مستقل GPS -->
    <script src="/js/gps-module.js"></script>
    <!-- اسکریپت کاکپیت سینمایی -->
    <script src="/js/game-client-simple.js"></script>
    <script>
        // اطمینان از بارگذاری کامل تابع
        document.addEventListener('DOMContentLoaded', function() {
            console.log('🔍 بررسی نهایی وجود تابع beginHackSequence:', typeof window.beginHackSequence);
            
            // اگر تابع موجود نیست، تلاش برای بارگذاری مجدد
            if (typeof window.beginHackSequence !== 'function') {
                console.warn('⚠️ تابع beginHackSequence در DOMContentLoaded موجود نیست - تلاش مجدد...');
                
                setTimeout(() => {
                    console.log('🔄 بررسی مجدد تابع:', typeof window.beginHackSequence);
                }, 1000);
            } else {
                console.log('✅ تابع beginHackSequence آماده است');
            }
            
            // حذف ویجت قدیمی پرونده دانش‌آموزان
            // ===== Status topbar init (ping, location source, contrast) =====
            try {
                // Location source init
                (function(){
                    function updateLoc(src){ var el = document.getElementById('locSrc'); if (el) el.textContent = src || (window.__locSource || '--'); }
                    window.addEventListener('locsource', function(e){ updateLoc(e && e.detail); });
                    updateLoc(window.__locSource);
                })();

                // Ping loop
                (function(){
                    const pingEl = document.getElementById('pingVal');
                    async function doPing(){
                        const t0 = Date.now();
                        try { const r = await fetch('/api/ping', { cache: 'no-store' }); if (!r.ok) throw 0; await r.json(); const dt = Date.now()-t0; if (pingEl) pingEl.textContent = dt; }
                        catch(_) { if (pingEl) pingEl.textContent = '--'; }
                    }
                    setInterval(doPing, 4000); doPing();
                })();

                // Smart Auto-Scroll
                (function(){
                    const list = document.getElementById('chatMessages');
                    const btn = document.getElementById('scrollBottomBtn');
                    function atBottom(){ return Math.abs(list.scrollHeight - list.clientHeight - list.scrollTop) < 8; }
                    function updateState(){
                        const isBottom = atBottom();
                        window.__autoScrollEnabled = isBottom; // only autoscroll when at bottom
                        if (btn) btn.style.display = isBottom ? 'none' : 'block';
                    }
                    if (list) {
                        list.addEventListener('scroll', updateState);
                        updateState();
                    }
                    if (btn) {
                        btn.addEventListener('click', function(){
                            const end = list.scrollHeight - list.clientHeight;
                            const start = list.scrollTop; const dur = 350; let st;
                            function step(ts){ if(!st) st = ts; const p=Math.min(1,(ts-st)/dur); const e=p<.5?4*p*p*p:1-Math.pow(-2*p+2,3)/2; list.scrollTop=start+(end-start)*e; if(p<1) requestAnimationFrame(step); }
                            requestAnimationFrame(step);
                            window.__autoScrollEnabled = true;
                            btn.style.display = 'none';
                        });
                    }
                })();

                // Adaptive Font Size (buttons + Alt shortcuts) up to 50px
                (function(){
                    const MIN = 12, MAX = 50, STEP = 2, DEFAULT_PX = 18;
                    function clamp(v){ return Math.max(MIN, Math.min(MAX, v)); }
                    function applyPx(px){
                        px = clamp(px);
                        document.body.style.setProperty('--msg-font-size', px + 'px');
                        const lh = px >= 36 ? 1.8 : px >= 28 ? 1.65 : px >= 22 ? 1.6 : 1.5;
                        document.body.style.setProperty('--msg-line-height', String(lh));
                        try { localStorage.setItem('msgSizePx', String(px)); } catch(e) {}
                    }
                    (function load(){
                        let px = DEFAULT_PX;
                        try { const saved = parseInt(localStorage.getItem('msgSizePx')||''); if (!Number.isNaN(saved)) px = saved; } catch(e) {}
                        applyPx(px);
                    })();

                    // Header buttons
                    const decBtn = document.getElementById('fontDecBtn');
                    const incBtn = document.getElementById('fontIncBtn');
                    const resetBtn = document.getElementById('fontResetBtn');
                    function currentPx(){
                        const v = getComputedStyle(document.body).getPropertyValue('--msg-font-size').trim();
                        const n = parseInt(v.replace('px',''));
                        return Number.isNaN(n) ? DEFAULT_PX : n;
                    }
                    if (decBtn) decBtn.addEventListener('click', function(){ applyPx(currentPx() - STEP); });
                    if (incBtn) incBtn.addEventListener('click', function(){ applyPx(currentPx() + STEP); });
                    if (resetBtn) resetBtn.addEventListener('click', function(){ applyPx(DEFAULT_PX); });

                    // Keyboard shortcuts
                    document.addEventListener('keydown', function(e){
                        if (!e.altKey) return;
                        if (e.key === '=') { applyPx(currentPx() + STEP); e.preventDefault(); }
                        else if (e.key === '-') { applyPx(currentPx() - STEP); e.preventDefault(); }
                        else if (e.key === '0') { applyPx(DEFAULT_PX); e.preventDefault(); }
                    });
                })();
            } catch (e) { console.warn('status topbar init failed', e); }
        });
    </script>
</body>
