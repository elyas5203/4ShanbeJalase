<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ترمینال ارتباطی امن</title>
    <link rel="icon" href="/assets/hacker.mask.png" type="image/png">
    
    <!-- MapLibre GL for Cyber Surveillance Map -->
    <link href="https://unpkg.com/maplibre-gl@latest/dist/maplibre-gl.css" rel="stylesheet" />
    <script src="https://unpkg.com/maplibre-gl@latest/dist/maplibre-gl.js" defer></script>
    <!-- Leaflet (for independent live GPS module) -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="" defer></script>
    <link rel="dns-prefetch" href="https://unpkg.com">
    <link rel="preconnect" href="https://unpkg.com" crossorigin>
    <link rel="dns-prefetch" href="https://basemaps.cartocdn.com">
    <link rel="preconnect" href="https://basemaps.cartocdn.com" crossorigin>
    <link rel="dns-prefetch" href="https://tile.openstreetmap.org">
    <link rel="preconnect" href="https://tile.openstreetmap.org" crossorigin>
    <link rel="dns-prefetch" href="https://tile.openstreetmap.fr">
    <link rel="preconnect" href="https://tile.openstreetmap.fr" crossorigin>
    <!-- App styles: includes Live GPS Map CSS (sonar marker, error banner) -->
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/photoswipe@5/dist/photoswipe.css">
    
    <!-- DSEG7 Font for Digital Clock (reliable CDN) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/dseg7-classic@5.2.5/index.css">
    <!-- Readable Persian font for body text -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/vazirmatn@5.2.5/index.css">
    
    <style>
        /* ========== ROOT VARIABLES ========== */
        :root {
            --bg-primary: #020309;
            --bg-secondary: #05070d;
            --bg-tertiary: #0a0f1f;
            --panel-bg: rgba(20, 35, 60, 0.35);
            --border-neon: rgba(90, 220, 255, 0.85);
            --glow: rgba(90, 220, 255, 0.35);
            --text: #d9f6ff;
            --accent: #75e5ff;
            --grid: rgba(140, 200, 255, 0.12);
            --chat-user: #a6ffe0;
            --chat-admin: #54ffbd;
            --msg-font-size: 18px;
            --msg-line-height: 1.5;
        }

        

        /* ========== BASE STYLES ========== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
            font-family: 'Vazirmatn', ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, 'Helvetica Neue', Arial;
            background: radial-gradient(1200px circle at 60% 40%, var(--bg-tertiary) 0%, var(--bg-secondary) 40%, var(--bg-primary) 100%);
            color: var(--text);
            overflow: hidden;
        }

        /* ========== GRID BACKGROUND ========== */
        .bg-grid::before {
            content: "";
            position: fixed;
            inset: 0;
            background-image: 
                linear-gradient(var(--grid) 1px, transparent 1px),
                linear-gradient(90deg, var(--grid) 1px, transparent 1px);
            background-size: 24px 24px;
            mask-image: radial-gradient(800px circle at 50% 50%, rgba(0,0,0,0.9), transparent 75%);
            pointer-events: none;
            z-index: 0;
        }

        /* ========== MAIN LAYOUT ========== */
        .cockpit-container {
            display: grid;
            grid-template-rows: 80px 1fr;
            grid-template-columns: 15% 70% 15%;
            height: 100vh;
            gap: 10px;
            padding: 10px;
            position: relative;
            z-index: 1;
        }

        /* ========== HEADER (DIGITAL CLOCK) ========== */
        .header {
            grid-column: 1 / -1;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .clock-wrap {
            position: relative;
            padding: 16px 24px;
            border-radius: 12px;
            background: var(--panel-bg);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(120, 210, 255, 0.35);
            box-shadow: 0 0 0 1px var(--border-neon) inset, 0 0 20px var(--glow);
        }

        .clock {
            font-family: 'DSEG7 Classic', 'DSEG7', monospace;
            font-size: 32px;
            letter-spacing: 0.06em;
            color: var(--text);
            text-shadow: 0 0 6px rgba(80, 200, 255, 0.6), 0 0 14px rgba(80, 200, 255, 0.25);
        }

        .clock .sep {
            animation: blink 1s steps(1, end) infinite;
        }

        @keyframes blink {
            0%, 49% { opacity: 1; }
            50%, 100% { opacity: 0.25; }
        }

        /* ========== RIGHT COLUMN (3D EARTH) ========== */
        .earth-column {
            grid-row: 2;
            grid-column: 3;
            position: relative;
            border-radius: 12px;
            background: var(--panel-bg);
            backdrop-filter: blur(14px);
            border: 1px solid rgba(120, 210, 255, 0.35);
            box-shadow: 
                0 0 0 1px var(--border-neon) inset,
                0 0 22px var(--glow);
            overflow: hidden;
        }

        #map-container {
            width: 100%;
            height: 100%;
            display: block;
        }

        /* ========== CENTER COLUMN (CHAT) ========== */
        .chat-column {
            grid-row: 2;
            grid-column: 2;
            display: flex;
            flex-direction: column;
            border-radius: 12px;
            background: var(--panel-bg);
            backdrop-filter: blur(14px);
            border: 1px solid rgba(120, 210, 255, 0.35);
            box-shadow: 
                0 0 0 1px var(--border-neon) inset,
                0 0 22px var(--glow);
            overflow: hidden;
        }

        .chat-header {
            padding: 12px 16px;
            background: rgba(20, 35, 60, 0.5);
            border-bottom: 1px solid rgba(120, 210, 255, 0.2);
            font-size: 14px;
            font-weight: bold;
            text-align: center;
            color: var(--accent);
        }

        /* Top status bar under chat title */
        .status-topbar {
            margin-top: 6px;
            display: flex;
            justify-content: center;
            gap: 12px;
            font-weight: normal;
            font-size: 11px;
            color: rgba(255,255,255,.8);
            letter-spacing: .2px;
        }
        .status-dot {
            display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-left: 6px;
            background: #ff6666; box-shadow: 0 0 8px rgba(255,102,102,.6);
        }
        .status-dot.online { background:#22c55e; box-shadow: 0 0 8px rgba(34,197,94,.7); }
        .status-chip { padding: 2px 8px; border: 1px solid rgba(120,210,255,.35); border-radius: 999px; background: rgba(10,18,32,.45); }
        .chip-btn { display:inline-flex; align-items:center; gap:6px; padding: 4px 10px; border: 1px solid rgba(120,210,255,.55); border-radius: 999px; background: linear-gradient(180deg, rgba(10,18,32,.65), rgba(10,18,32,.4)); color: #cfefff; box-shadow: 0 0 10px rgba(120,210,255,.15); cursor: pointer; transition: all .2s ease; }
        .chip-btn:hover { transform: translateY(-1px); box-shadow: 0 0 14px rgba(120,210,255,.35); }
        .chip-btn:active { transform: translateY(0); filter: brightness(1.05); }

        .chat-messages {
            flex: 1;
            padding: 8px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 2px;
            position: relative;
        }

        .scroll-bottom-btn { display: none; }

        .message {
            max-width: 45%;
            display: flex;
            align-items: flex-start;
            gap: 4px;
            margin-bottom: 2px;
            clear: both;
            position: relative;
        }

        .message-avatar {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            border: 1px solid rgba(84, 255, 189, 0.5);
            background: rgba(84, 255, 189, 0.1);
            box-shadow: 0 0 4px rgba(84, 255, 189, 0.3);
            flex-shrink: 0;
            overflow: hidden;
        }

        .message-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 50%;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .message-avatar img:hover {
            transform: scale(1.1);
            box-shadow: 0 0 15px rgba(84, 255, 189, 0.6);
        }

        /* Modal برای نمایش آواتار بزرگ */
        .avatar-modal {
            display: none;
            position: fixed;
            z-index: 9999;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(5px);
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .avatar-modal-content {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: rgba(20, 35, 60, 0.95);
            border: 2px solid rgba(84, 255, 189, 0.5);
            border-radius: 20px;
            padding: 20px;
            box-shadow: 0 0 30px rgba(84, 255, 189, 0.3);
            text-align: center;
            max-width: 400px;
            width: 90%;
        }

        .avatar-modal img {
            width: 200px;
            height: 200px;
            object-fit: cover;
            border-radius: 50%;
            border: 3px solid rgba(84, 255, 189, 0.7);
            box-shadow: 0 0 20px rgba(84, 255, 189, 0.4);
            margin-bottom: 15px;
            transform: scale(0.8);
            transition: transform 0.3s ease;
        }

        .avatar-modal-title {
            color: var(--glow);
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 10px;
            text-shadow: 0 0 10px rgba(84, 255, 189, 0.5);
        }

        .avatar-modal-close {
            position: absolute;
            top: 10px;
            right: 15px;
            color: #ff6b6b;
            font-size: 28px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .avatar-modal-close:hover {
            color: #ff5252;
            text-shadow: 0 0 10px #ff5252;
            transform: scale(1.2);
        }

        /* ========== HACK SEQUENCE STYLES ========== */
        .hack-sequence-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: #000;
            z-index: 99999;
            display: none;
            overflow: hidden;
        }

        .hack-sequence-overlay.show {
            display: block;
        }

        /* مرحله خطر و آژیر */
        .danger-stage {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            opacity: 0;
            transition: opacity 0.5s ease;
        }

        .danger-stage.show {
            opacity: 1;
        }

        .danger-skull {
            font-size: 8vw;
            color: #ff1e2d;
            text-shadow: 0 0 20px #ff1e2d, 0 0 40px #ff1e2d;
            animation: heartbeat 1s infinite;
            margin-bottom: 2rem;
        }

        @keyframes heartbeat {
            0%, 100% { transform: scale(1); }
            20% { transform: scale(1.2); }
            40% { transform: scale(0.9); }
            60% { transform: scale(1.15); }
        }

        .danger-vignette {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle, rgba(255, 30, 45, 0.6) 0%, rgba(0, 0, 0, 0.9) 100%);
            animation: vignettePulse 1s infinite;
            pointer-events: none;
        }

        @keyframes vignettePulse {
            0%, 100% { opacity: 0.3; }
            50% { opacity: 0.8; }
        }

        .danger-noise {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: repeating-linear-gradient(
                0deg,
                transparent,
                transparent 2px,
                rgba(255, 255, 255, 0.03) 2px,
                rgba(255, 255, 255, 0.03) 4px
            );
            opacity: 0.15;
            animation: noise 0.1s infinite;
            pointer-events: none;
        }

        @keyframes noise {
            0% { transform: translateY(0); }
            100% { transform: translateY(-4px); }
        }

        .danger-text {
            position: absolute;
            bottom: 10vh;
            left: 50%;
            transform: translateX(-50%);
            font-size: 1.9rem;
            color: #fff;
            text-shadow: 0 0 10px #fff, 0 0 20px #ff1e2d;
            text-align: center;
            opacity: 0;
            transition: opacity 0.5s ease;
            font-family: 'Share Tech Mono', monospace;
            animation: textGlitch 0.5s infinite;
        }

        .danger-text.show {
            opacity: 1;
        }

        @keyframes textGlitch {
            0%, 100% { transform: translateX(-50%) skew(0deg); }
            20% { transform: translateX(-50%) skew(1deg); }
            40% { transform: translateX(-50%) skew(-1deg); }
            60% { transform: translateX(-50%) skew(0.5deg); }
            80% { transform: translateX(-50%) skew(-0.5deg); }
        }

        /* انیمیشن CRT خاموشی */
        .crt-shutdown {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: #fff;
            opacity: 0;
        }

        .crt-shutdown.active {
            opacity: 1;
            animation: crtShutdown 3s ease-out forwards;
        }

        @keyframes crtShutdown {
            0% {
                transform: scaleY(1) scaleX(1);
                opacity: 1;
            }
            50% {
                transform: scaleY(0.1) scaleX(1);
                opacity: 0.8;
            }
            100% {
                transform: scaleY(0.01) scaleX(0.01);
                opacity: 0;
            }
        }

        /* مرحله پیام ترسناک */
        .scary-message-stage {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            opacity: 0;
            transition: opacity 0.6s ease;
        }

        .scary-message-stage.show {
            opacity: 1;
        }

        .scary-text {
            font-size: 2rem;
            color: #ff1e2d;
            text-shadow: 0 0 20px #ff1e2d;
            text-align: center;
            font-family: 'Share Tech Mono', monospace;
            animation: scaryGlow 2s infinite;
        }

        @keyframes scaryGlow {
            0%, 100% { 
                text-shadow: 0 0 20px #ff1e2d;
                transform: scale(1);
            }
            50% { 
                text-shadow: 0 0 30px #ff1e2d, 0 0 40px #ff1e2d;
                transform: scale(1.05);
            }
        }

        /* مرحله ترمینال */
        .terminal-stage {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            opacity: 0;
            transition: opacity 0.6s ease;
            padding: 2rem;
            box-sizing: border-box;
        }

        .terminal-stage.show {
            opacity: 1;
        }

        .hack-terminal {
            width: 90%;
            max-width: 800px;
            height: 80%;
            background: rgba(0, 0, 0, 0.95);
            border: 2px solid #00ff00;
            border-radius: 10px;
            padding: 20px;
            font-family: 'Share Tech Mono', monospace;
            color: #00ff00;
            overflow-y: auto;
            box-shadow: 
                0 0 20px rgba(0, 255, 0, 0.5),
                inset 0 0 20px rgba(0, 255, 0, 0.1);
        }

        .terminal-header {
            color: #ff6b6b;
            font-size: 1.2rem;
            margin-bottom: 1rem;
            text-shadow: 0 0 10px #ff6b6b;
        }

        .terminal-content {
            font-size: 1rem;
            line-height: 1.5;
        }

        .terminal-cursor {
            display: inline-block;
            width: 10px;
            height: 1.2em;
            background: #00ff00;
            animation: blink 1s infinite;
            margin-left: 2px;
        }

        @keyframes blink {
            0%, 50% { opacity: 1; }
            51%, 100% { opacity: 0; }
        }

        .hack-video {
            width: 100%;
            max-width: 600px;
            border: 2px solid #00ff00;
            border-radius: 5px;
            margin: 1rem 0;
            box-shadow: 0 0 15px rgba(0, 255, 0, 0.3);
        }

        /* ========== HOLOGRAPHIC DATA PACKETS ========== */
        
        /* بسته داده اصلی */
        .message-packet {
            position: relative;
            margin: 8px 0;
            max-width: 320px;
            min-width: 120px;
            background: rgba(0, 20, 40, 0.4);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(0, 255, 255, 0.3);
            clip-path: polygon(12px 0%, 100% 0%, 100% calc(100% - 12px), calc(100% - 12px) 100%, 0% 100%, 0% 12px);
            box-shadow: 
                0 0 15px rgba(0, 255, 255, 0.2),
                inset 0 0 15px rgba(0, 255, 255, 0.05);
            animation: packetGlow 3s ease-in-out infinite alternate;
            transition: all 0.3s ease;
        }
        
        .message-packet:hover {
            transform: translateY(-2px);
            box-shadow: 
                0 0 25px rgba(0, 255, 255, 0.4),
                inset 0 0 20px rgba(0, 255, 255, 0.1);
        }
        
        /* بسته داده کاربر - سمت راست */
        .message-packet.user-message {
            align-self: flex-end;
            margin-left: auto;
            background: rgba(0, 40, 20, 0.4);
            border-color: rgba(0, 255, 100, 0.35);
            box-shadow: 
                0 0 20px rgba(0, 255, 100, 0.25),
                inset 0 0 15px rgba(0, 255, 100, 0.05);
        }
        /* محتوای پیام کاربر از متغیرهای سراسری تبعیت کند */
        .message-packet.user-message .packet-content {
            font-size: var(--msg-font-size);
            line-height: var(--msg-line-height);
        }
        
        .message-packet.user-message:hover {
            box-shadow: 
                0 0 25px rgba(0, 255, 100, 0.4),
                inset 0 0 20px rgba(0, 255, 100, 0.1);
        }
        
        /* بسته داده ادمین - سمت چپ */
        .message-packet.admin-message {
            align-self: flex-start;
            margin-right: auto;
        }
        
        /* بسته داده هکر */
        .message-packet.hacker-message {
            background: rgba(40, 0, 0, 0.4);
            border-color: rgba(255, 0, 100, 0.4);
            box-shadow: 
                0 0 15px rgba(255, 0, 100, 0.3),
                inset 0 0 15px rgba(255, 0, 100, 0.05);
            animation: hackerPacketGlow 2s ease-in-out infinite alternate;
        }
        
        .message-packet.hacker-message:hover {
            box-shadow: 
                0 0 30px rgba(255, 0, 100, 0.5),
                inset 0 0 25px rgba(255, 0, 100, 0.15);
        }
        
        /* هدر بسته */
        .packet-header {
            display: flex;
            align-items: center;
            padding: 6px 12px;
            background: rgba(0, 255, 255, 0.1);
            border-bottom: 1px solid rgba(0, 255, 255, 0.2);
            font-size: 11px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: rgba(0, 255, 255, 0.9);
        }
        
        .user-message .packet-header {
            background: rgba(0, 255, 100, 0.1);
            border-bottom-color: rgba(0, 255, 100, 0.2);
            color: rgba(0, 255, 100, 0.9);
        }
        
        .hacker-message .packet-header {
            background: rgba(255, 0, 100, 0.1);
            border-bottom-color: rgba(255, 0, 100, 0.2);
            color: rgba(255, 0, 100, 0.9);
        }
        
        .sender-icon {
            margin-left: 6px;
            font-size: 12px;
        }
        
        /* آواتار در هدر بسته */
        .sender-avatar {
            margin-left: 8px;
            display: inline-flex;
            align-items: center;
        }
        
        .packet-avatar {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            border: 1px solid rgba(255, 255, 255, 0.3);
            object-fit: cover;
            transition: all 0.3s ease;
            cursor: pointer;
        }
        
        .packet-avatar:hover {
            transform: scale(1.1);
            border-color: rgba(0, 255, 255, 0.6);
            box-shadow: 0 0 8px rgba(0, 255, 255, 0.4);
        }
        
        .user-message .packet-avatar {
            border-color: rgba(0, 255, 100, 0.4);
        }
        
        .user-message .packet-avatar:hover {
            border-color: rgba(0, 255, 100, 0.8);
            box-shadow: 0 0 8px rgba(0, 255, 100, 0.4);
        }
        
        .hacker-message .packet-avatar {
            border-color: rgba(255, 0, 100, 0.4);
        }
        
        .hacker-message .packet-avatar:hover {
            border-color: rgba(255, 0, 100, 0.8);
            box-shadow: 0 0 8px rgba(255, 0, 100, 0.4);
        }
        
        .system-message .packet-avatar {
            border-color: rgba(255, 255, 0, 0.4);
        }
        
        .system-message .packet-avatar:hover {
            border-color: rgba(255, 255, 0, 0.8);
            box-shadow: 0 0 8px rgba(255, 255, 0, 0.4);
        }
        
        /* محتوای بسته و پیام ساده چت */
        .packet-content,
        .message-content {
            padding: 12px;
            color: #ffffff;
            font-size: var(--msg-font-size);
            line-height: var(--msg-line-height);
            text-align: right;
            direction: rtl;
            word-wrap: break-word;
            overflow-wrap: break-word;
            white-space: pre-wrap;
        }

        /* Adaptive font sizes */
        body.msg-size-s { --msg-font-size: 16px; --msg-line-height: 1.45; }
        body.msg-size-m { --msg-font-size: 18px; --msg-line-height: 1.5; }
        body.msg-size-l { --msg-font-size: 22px; --msg-line-height: 1.6; }

        /* High-contrast toggle mode */
        body.contrast-high {
            --panel-bg: rgba(14, 28, 48, 0.65);
            --border-neon: rgba(120, 230, 255, 0.95);
            --glow: rgba(120, 230, 255, 0.55);
        }
        body.contrast-high .chat-column, body.contrast-high .earth-column, body.contrast-high .hud-widget {
            box-shadow: 0 0 0 1px var(--border-neon) inset, 0 0 28px var(--glow);
            border-color: var(--border-neon);
        }
        
        .packet-content img,
        .packet-content video {
            max-width: 100%;
            border-radius: 6px;
            margin: 8px 0;
            cursor: zoom-in;
            transition: transform 0.2s ease;
        }
        
        .packet-content img:hover,
        .packet-content video:hover {
            transform: scale(1.02);
        }
        
        /* فوتر بسته */
        .packet-footer {
            display: flex;
            justify-content: flex-end;
            padding: 4px 12px;
            background: rgba(0, 0, 0, 0.2);
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }
        
        .message-time {
            font-size: 10px;
            color: rgba(255, 255, 255, 0.6);
            font-family: 'Courier New', monospace;
            direction: ltr;
        }
        
        /* انیمیشن‌ها */
        @keyframes packetGlow {
            0% { 
                box-shadow: 
                    0 0 15px rgba(0, 255, 255, 0.2),
                    inset 0 0 15px rgba(0, 255, 255, 0.05);
            }
            100% { 
                box-shadow: 
                    0 0 20px rgba(0, 255, 255, 0.3),
                    inset 0 0 20px rgba(0, 255, 255, 0.08);
            }
        }
        
        @keyframes hackerPacketGlow {
            0% { 
                box-shadow: 
                    0 0 15px rgba(255, 0, 100, 0.3),
                    inset 0 0 15px rgba(255, 0, 100, 0.05);
            }
            100% { 
                box-shadow: 
                    0 0 25px rgba(255, 0, 100, 0.5),
                    inset 0 0 20px rgba(255, 0, 100, 0.1);
            }
        }
        
        /* پیام سیستم */
        .system-message {
            align-self: center;
            background: rgba(255, 255, 0, 0.1);
            border-color: rgba(255, 255, 0, 0.3);
            color: #ffff99;
            text-align: center;
            font-style: italic;
            max-width: 280px;
        }
        
        .system-message .packet-header {
            background: rgba(255, 255, 0, 0.1);
            border-bottom-color: rgba(255, 255, 0, 0.2);
            color: rgba(255, 255, 0, 0.9);
            justify-content: center;
        }

        .chat-input { 
            display: grid; 
            grid-template-columns: 1fr auto auto; 
            gap: 8px; 
            align-items: end; 
            padding: 10px; 
            background: rgba(10, 18, 32, 0.55); 
            border-top: 1px solid rgba(120, 210, 255, 0.25); 
        }

        .chat-input textarea {
            flex: 1;
            width: 100%;
            padding: 12px 14px;
            background: rgba(14, 24, 40, 0.55);
            border: 1px solid rgba(120, 210, 255, 0.28);
            border-radius: 10px;
            color: var(--text);
            font-size: 15px;
            font-family: inherit;
            resize: vertical;
            min-height: 44px;
            max-height: 140px;
            line-height: 1.45;
            box-sizing: border-box;
            direction: rtl;
            text-align: right;
        }

        .chat-input textarea:focus {
            outline: none;
            border-color: var(--border-neon);
            box-shadow: 0 0 10px var(--glow);
        }

        .chat-input button {
            height: 44px;
            padding: 0 16px;
            background: linear-gradient(180deg, rgba(0, 255, 136, 0.25), rgba(0, 255, 106, 0.18));
            border: 1px solid rgba(0, 255, 106, 0.6);
            border-radius: 10px;
            color: #19ff9f;
            cursor: pointer;
            font-family: inherit;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 0.3px;
            transition: all 0.2s ease;
            box-shadow: 0 0 10px rgba(0, 255, 106, 0.2);
        }

        .chat-input button:hover {
            transform: translateY(-1px);
            background: linear-gradient(180deg, rgba(0, 255, 136, 0.35), rgba(0, 255, 106, 0.28));
            box-shadow: 0 0 14px rgba(0, 255, 106, 0.35);
        }

        #fileButton { 
            width: 44px; 
            padding: 0; 
            display: inline-flex; 
            align-items: center; 
            justify-content: center; 
            background: linear-gradient(180deg, rgba(120, 210, 255, 0.15), rgba(120, 210, 255, 0.08));
            border: 1px solid rgba(120, 210, 255, 0.5);
            color: #8fd8ff;
        }

        #fileButton:hover {
            box-shadow: 0 0 12px rgba(120, 210, 255, 0.35);
        }

        /* ========== LEFT COLUMN (HUD WIDGETS) ========== */
        .hud-column {
            grid-row: 2;
            grid-column: 1;
            display: flex;
            flex-direction: column;
            gap: 12px;
            padding: 12px;
            overflow: hidden;
            height: 100%;
            max-height: 100%;
        }

        .hud-widget {
            padding: 12px;
            border-radius: 12px;
            background: var(--panel-bg);
            backdrop-filter: blur(14px);
            border: 1px solid rgba(120, 210, 255, 0.35);
            box-shadow: 
                0 0 0 1px var(--border-neon) inset,
                0 0 15px var(--glow);
            opacity: 0;
            transform: translateY(-8px) scale(0.98);
            animation: buildUp 900ms cubic-bezier(.22,.68,.13,1) forwards;
        }

        .hud-widget:nth-child(1) { animation-delay: 300ms; }
        .hud-widget:nth-child(2) { animation-delay: 500ms; }
        .hud-widget:nth-child(3) { animation-delay: 700ms; }
        .hud-widget:nth-child(4) { animation-delay: 900ms; }

        @keyframes buildUp {
            0% {
                opacity: 0;
                transform: translateY(-10px) scale(0.96);
            }
            60% {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
            100% {
                opacity: 1;
                transform: translateY(0) scale(1);
                filter: saturate(120%) brightness(1);
            }
        }

        .hud-title {
            font-size: 11px;
            color: var(--accent);
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .hud-content {
            font-size: 10px;
            line-height: 1.3;
            color: var(--text);
        }

        .hud-value {
            color: var(--accent);
            font-weight: bold;
        }

        .hud-bar {
            width: 100%;
            height: 4px;
            background: rgba(120, 210, 255, 0.2);
            border-radius: 2px;
            overflow: hidden;
            margin: 4px 0;
        }

        .hud-bar-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--accent), var(--border-neon));
            border-radius: 2px;
            box-shadow: 0 0 8px var(--accent);
        }
        /* (Old student modal styles removed) */

        /* انیمیشن روان برای نوار پیشرفت ماموریت */
        .mission-progress-bar {
            transition: width 0.8s ease-in-out;
            background: linear-gradient(90deg, #00ff88, #00ffff, #0088ff);
            box-shadow: 0 0 12px #00ff88, 0 0 24px rgba(0, 255, 136, 0.3);
            animation: missionGlow 2s ease-in-out infinite alternate;
        }
        
        @keyframes missionGlow {
            0% {
                box-shadow: 0 0 12px #00ff88, 0 0 24px rgba(0, 255, 136, 0.3);
            }
            100% {
                box-shadow: 0 0 16px #00ff88, 0 0 32px rgba(0, 255, 136, 0.5);
            }
        }

        /* ========== SECURITY TERMINAL ========== */
        .security-terminal {
            flex: 0 0 auto;
            margin: 0;
            padding: 0;
        }

        .security-terminal .hud-title {
            display: none;
        }

        .security-terminal .hud-content {
            padding: 0;
        }

        .cyber-terminal {
            background: rgba(5,10,6,0.85);
            border: 1px solid #00ff6a;
            border-radius: 6px;
            box-shadow: 0 0 15px rgba(0,255,106,0.3);
            display: flex;
            flex-direction: column;
            height: 180px;
            max-height: 180px;
            min-height: 180px;
            font-family: 'Cascadia Mono', 'Fira Code', Consolas, monospace;
            overflow: hidden;
        }

        .cyber-titlebar {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            border-bottom: 1px solid #00ff6a;
            background: linear-gradient(90deg, rgba(0,50,0,0.6), rgba(0,30,0,0.4));
            color: #19ff9f;
            font-weight: 700;
            font-size: 11px;
        }

        .cyber-terminal-body {
            flex: 1;
            padding: 6px;
            overflow-y: auto;
            overflow-x: hidden;
            line-height: 1.3;
            color: #00ff6a;
            background: rgba(10,15,10,0.9);
            font-size: 11px;
            position: relative;
            height: 140px;
            max-height: 140px;
            min-height: 140px;
            scroll-behavior: smooth;
        }

        /* اسکرول بار سفارشی برای ترمینال */
        .cyber-terminal-body::-webkit-scrollbar {
            width: 4px;
        }

        .cyber-terminal-body::-webkit-scrollbar-track {
            background: rgba(0,0,0,0.3);
        }

        .cyber-terminal-body::-webkit-scrollbar-thumb {
            background: rgba(0,255,106,0.5);
            border-radius: 2px;
        }

        .cyber-terminal-body::-webkit-scrollbar-thumb:hover {
            background: rgba(0,255,106,0.8);
        }

        .cyber-terminal-body::before {
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
            background: linear-gradient(rgba(0,0,0,0) 95%, rgba(0,255,120,0.08) 95.1%) 0 0/100% 3px;
        }

        .cyber-line {
            display: block;
            white-space: pre-wrap;
            word-break: break-word;
            margin-bottom: 1px;
        }

        .cyber-tag {
            color: #19ff9f;
            font-weight: 700;
        }

        .cyber-ok {
            color: #79ff97;
        }

        .cyber-warn {
            color: #ffd34f;
        }

        .cyber-error {
            color: #ff3e3e;
        }

        .cyber-muted {
            color: rgba(11,255,106,0.6);
        }

        .cyber-cursor {
            display: inline-block;
            width: 8px;
            height: 1.1em;
            background: #00ff6a;
            animation: cyber-blink 1s steps(2,end) infinite;
            vertical-align: text-bottom;
            margin-left: 2px;
        }

        @keyframes cyber-blink {
            50% { opacity: 0; }
        }

        /* ========== RESPONSIVE DESIGN ========== */
        @media (max-width: 1200px) {
            .cockpit-container {
                grid-template-columns: 20% 60% 20%;
            }
        }

        @media (max-width: 900px) {
            .cockpit-container {
                grid-template-rows: 60px 1fr 200px;
                grid-template-columns: 1fr;
                gap: 8px;
            }
            
            .header {
                grid-column: 1;
                grid-row: 1;
            }
            
            .chat-column {
                grid-column: 1;
                grid-row: 2;
            }
            
            .earth-column,
            .hud-column {
                display: none;
            }
            
            .clock {
                font-size: 24px;
            }
        }

        /* ========== SCROLLBAR STYLING ========== */
        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: rgba(20, 35, 60, 0.3);
        }

        ::-webkit-scrollbar-thumb {
            background: var(--border-neon);
            border-radius: 3px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: var(--accent);
        }
    </style>
</head>
<body class="bg-grid">
    <div class="cockpit-container">
        <!-- Header with Digital Clock -->
        <div class="header">
            <div class="clock-wrap">
                <div id="clock" class="clock"></div>
            </div>
        </div>

        <!-- Right Column: GPS Map -->
        <div class="earth-column">
            <!-- شروع ماژول ردیاب GPS (مستقل و بدون تداخل) -->
            <div id="live-gps-map-container">
              <div id="leaflet-map-element"></div>
            </div>
            <!-- نگه‌داشتن نقشه قدیمی برای سازگاری (پنهان می‌شود) -->
            <div id="map-container" style="display:none"></div>
        </div>

        <!-- Center Column: Chat -->
        <div class="chat-column">
            <div class="chat-header">
                ترمینال ارتباطات - جلسه فعال
                <div class="status-topbar" id="statusTopbar">
                    <span class="status-chip"><span class="status-dot" id="connDot"></span>اتصال</span>
                    <span class="status-chip">تاخیر: <span id="pingVal">--</span>ms</span>
                    <span class="status-chip">موقعیت: <span id="locSrc">--</span></span>
                    <button id="scrollBottomBtn" class="status-chip chip-btn scroll-bottom-btn" style="display: none;">↓ رفتن به آخر</button>
                    <div class="status-chip" style="display:inline-flex; gap:6px; align-items:center;">
                        اندازه متن:
                        <button id="fontDecBtn" class="chip-btn" title="کوچک‌تر">A−</button>
                        <button id="fontResetBtn" class="chip-btn" title="پیش‌فرض">A</button>
                        <button id="fontIncBtn" class="chip-btn" title="بزرگ‌تر">A+</button>
                    </div>
                </div>
            </div>
            <div class="chat-messages" id="chatMessages">
                <!-- Messages will be dynamically added here -->
            </div>
            <div class="chat-input">
                <textarea id="messageInput" placeholder="پیام خود را اینجا بنویسید..." rows="1"></textarea>
                <input type="file" id="fileInput" style="display: none;" accept="image/*,video/*,audio/*" onchange="
                    console.log('📁 فایل انتخاب شد:', this.files[0]?.name); 
                    const file = this.files[0];
                    if (!file) return;
                    
                    // بررسی اندازه فایل (حداکثر 1GB)
                    if (file.size > 1024 * 1024 * 1024) {
                        alert('❌ خطا: اندازه فایل نباید بیشتر از 1GB باشد');
                        this.value = '';
                        return;
                    }
                    
                    console.log('🚀 شروع آپلود مستقیم...');
                    const formData = new FormData();
                    formData.append('file', file);
                    formData.append('userId', '<%= user.id %>');
                    formData.append('senderType', 'user');
                    
                    fetch('/upload', {
                        method: 'POST',
                        body: formData
                    })
                    .then(response => {
                        console.log('📡 پاسخ سرور:', response.status, response.statusText);
                        
                        if (!response.ok) {
                            throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                        }
                        
                        // بررسی نوع محتوا
                        const contentType = response.headers.get('content-type');
                        if (!contentType || !contentType.includes('application/json')) {
                            throw new Error('سرور پاسخ JSON نداد - احتمالاً فایل بزرگ‌تر از 1GB است');
                        }
                        
                        return response.json();
                    })
                    .then(data => {
                        console.log('📦 نتیجه:', data);
                        if (data.success) {
                            console.log('✅ فایل آپلود شد - منتظر Socket.IO...');
                        } else {
                            alert('❌ خطا: ' + data.error);
                        }
                    })
                    .catch(error => {
                        console.error('❌ خطا در آپلود:', error);
                        alert('❌ خطا در آپلود: ' + error.message);
                    });
                    
                    this.value = '';
                ">
                <button type="button" id="fileButton" onclick="document.getElementById('fileInput').click(); console.log('📎 کلیک مستقیم روی دکمه فایل');">📎</button>
                <button id="sendButton">ارسال</button>
            </div>
        </div>

        <!-- Left Column: HUD Widgets -->
        <div class="hud-column">
            <div class="hud-widget">
                <div class="hud-title">وضعیت سیستم</div>
                <div class="hud-content">
                    CPU: <span class="hud-value" id="cpu-usage">45%</span>
                    <div class="hud-bar">
                        <div class="hud-bar-fill" style="width: 45%"></div>
                    </div>
                    RAM: <span class="hud-value" id="ram-usage">67%</span>
                    <div class="hud-bar">
                        <div class="hud-bar-fill" style="width: 67%"></div>
                    </div>
                    NET: <span class="hud-value">ONLINE</span>
                </div>
            </div>

            <div class="hud-widget">
                <div class="hud-title">اطلاعات ماموریت</div>
                <div class="hud-content">
                    فاز: <span class="hud-value">عادی</span><br>
                    وضعیت: <span class="hud-value">فعال</span><br>
                    پیشرفت: <span class="hud-value" id="progress-text">0%</span>
                    <div class="hud-bar">
                        <div class="hud-bar-fill mission-progress-bar" id="progress-bar" style="width: 0%"></div>
                    </div>
                </div>
            </div>

            <div class="hud-widget security-terminal">
                <div class="cyber-terminal">
                    <div class="cyber-titlebar">ترمینال امنیتی — مرکز عملیات سایبری</div>
                    <div id="cyber-term" class="cyber-terminal-body" aria-live="polite"></div>
                </div>
            </div>

            <div class="hud-widget">
                <div class="hud-title">آمار جلسه</div>
                <div class="hud-content">
                    پیام‌ها: <span class="hud-value" id="message-count">0</span><br>
                    مدت زمان: <span class="hud-value" id="session-time">00:00</span><br>
                    کاربران: <span class="hud-value">1</span>
                </div>
            </div>

            <div class="hud-widget">
                <div class="hud-title">امنیت</div>
                <div class="hud-content">
                    رمزنگاری: <span class="hud-value">فعال</span><br>
                    احراز هویت: <span class="hud-value">تأیید شده</span><br>
                    سطح دسترسی: <span class="hud-value">کاربر</span>
                    <button id="open-personnel-btn" type="button" class="hud-small-btn">👥 پرونده دستیاران</button>
                </div>
            </div>
        </div>
    </div>

    <!-- User Variables (globals for game-client-simple.js) -->
    <script>
        window.userId = <%- JSON.stringify(userId) %>;
        window.username = <%- JSON.stringify(username) %>;
        // Fallback: if user.class_id is missing, use username
        window.classId = <%- (typeof user !== 'undefined' && user && (user.class_id || user.username)) ? JSON.stringify(user.class_id || user.username) : 'null' %>;
        window.students = <%- JSON.stringify(typeof students !== 'undefined' ? students : []) %>;
    </script>

    <!-- Holographic Personnel Overlay (hidden by default) -->
    <div id="personnel-overlay" class="personnel-overlay holo-bg" aria-hidden="true" style="display:none;">
        <button id="personnel-close" class="personnel-close" aria-label="بستن">×</button>
        <div class="app" id="personnel-app">
            <!-- left: master list -->
            <aside class="panel sidebar">
                <div class="divider"></div>
                <div class="sidebar-header">
                    <span class="holo-title">Directory</span>
                    <span style="font-size:12px; color:var(--muted)">Personnel Files</span>
                </div>
                <div class="search">
                    <input id="personnel-q" type="text" placeholder="جستجو نام / شناسه...">
                    <button id="personnel-shuffle">Shuffle</button>
                </div>
                <div class="list" id="personnel-list"></div>
            </aside>

            <!-- right: detail -->
            <section class="panel detail">
                <header class="detail-header">
                    <div class="id">
                        <div>
                            <div class="name" id="personnel-name">—</div>
                            <div style="color:var(--muted); font-size:12px;" id="personnel-role">—</div>
                        </div>
                    </div>
                </header>

                <div class="detail-content">
                    <div>
                        <div class="photo-wrap">
                            <div class="photo"><img id="personnel-mainPhoto" src="" alt=""></div>
                            <div class="scan-mask" id="personnel-scanMask"></div>
                            <div class="fs-cta">
                                <button id="personnel-zoomIn">Zoom In</button>
                                <button id="personnel-zoomOut">Zoom Out</button>
                            </div>
                        </div>
                        <div class="gallery-strip" id="personnel-galleryStrip"></div>
                    </div>
                </div>
            </section>
        </div>
        <!-- PhotoSwipe root inside overlay -->
        <div class="pswp" id="pswp" role="dialog" aria-hidden="true"></div>
    </div>
    
    <script src="/socket.io/socket.io.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/photoswipe@5/dist/photoswipe.umd.min.js"></script>
    <script>
        // ========== DIGITAL CLOCK ========== 
        function pad(n) { 
            return n < 10 ? '0' + n : '' + n; 
        }
        
        function updateClock() { 
            const now = new Date();
            const h = pad(now.getHours());
            const m = pad(now.getMinutes());
            const s = pad(now.getSeconds());
            document.getElementById('clock').innerHTML = `${h}<span class="sep">:</span>${m}<span class="sep">:</span>${s}`;
            requestAnimationFrame(updateClock); 
        }
        updateClock();

        // GPS map is initialized by window.initGPSMap() from /js/game-client-simple.js

        // ========== HUD UPDATES ========== 
        let hudMessageCount = 0; // تغییر نام برای جلوگیری از تداخل
        let sessionStartTime = Date.now();
        
        function updateHUD() {
            // Update CPU/RAM randomly for demo
            const cpu = Math.floor(Math.random() * 30) + 30;
            const ram = Math.floor(Math.random() * 40) + 50;
            
            document.getElementById('cpu-usage').textContent = cpu + '%';
            document.querySelector('.hud-widget:nth-child(1) .hud-bar-fill').style.width = cpu + '%';
            
            document.getElementById('ram-usage').textContent = ram + '%';
            document.querySelector('.hud-widget:nth-child(1) .hud-bar:nth-child(4) .hud-bar-fill').style.width = ram + '%';
            
            // Update session time
            const elapsed = Math.floor((Date.now() - sessionStartTime) / 1000);
            const minutes = Math.floor(elapsed / 60);
            const seconds = elapsed % 60;
            document.getElementById('session-time').textContent = `${pad(minutes)}:${pad(seconds)}`;
            
            // Update message count
            document.getElementById('message-count').textContent = hudMessageCount;
        }
        
        setInterval(updateHUD, 2000);

        // ========== CHAT FUNCTIONALITY ========== 
        let socket;
        
        function initChat() {
            socket = io({
                query: {
                    userId: userId,
                    username: username
                }
            });
            
            socket.on('connect', () => {
                console.log('🔗 متصل به سرور - User ID:', userId);
                addMessage('سیستم', 'اتصال برقرار شد', 'system');
                try { var cd = document.getElementById('connDot'); if (cd) cd.classList.add('online'); } catch(e) {}
                
                // اطلاع‌رسانی به سرور که کاربر آماده دریافت events است
                socket.emit('user_ready', { userId: userId });
            });
            
            socket.on('disconnect', () => {
                console.log('🔌 اتصال قطع شد');
                addMessage('سیستم', 'اتصال قطع شد', 'system');
                 try { var cd2 = document.getElementById('connDot'); if (cd2) cd2.classList.remove('online'); } catch(e) {}
            });

            // Hack sequence event listener
            socket.on('start_hack_sequence', (data) => {
