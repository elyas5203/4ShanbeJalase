        function addMessage(sender, content, type, isScrambled = false) {
            const messagesContainer = document.getElementById('chatMessages');
            const messageDiv = document.createElement('div');
            messageDiv.className = `message ${type}`;
            
            // تعیین آواتار بر اساس نوع فرستنده
            const avatars = {
                'user': '/images/avatars/user.png',
                'admin': '/images/avatars/admin.png',
                'detective': '/images/avatars/karagah.png',
                'hacker': '/images/avatars/hacker.png',
                'system': '/images/avatars/system.png'
            };
            
            const avatarSrc = avatars[type] || '/images/avatars/default.png';
            
            // ساخت HTML با آواتار عکسی
            const avatarHTML = `<div class="message-avatar"><img src="${avatarSrc}" alt="${type}" onclick="openAvatarModal('${avatarSrc}', '${sender}')" onerror="this.style.display='none'; this.parentElement.innerHTML='❓';"></div>`;
            const contentHTML = `<div class="message-content">${isScrambled ? '█ █ █ █ █ █ █ █' : content}</div>`;
            
            messageDiv.innerHTML = avatarHTML + contentHTML;
            
            if (isScrambled) {
                setTimeout(() => {
                    const contentElement = messageDiv.querySelector('.message-content');
                    if (contentElement) {
                        contentElement.innerHTML = content;
                    }
                }, 1000);
            }
            
            messagesContainer.appendChild(messageDiv);
            // Smart auto-scroll: only if user is at bottom
            if (window.__autoScrollEnabled !== false) {
                try {
                    const start = messagesContainer.scrollTop;
                    const end = messagesContainer.scrollHeight - messagesContainer.clientHeight;
                    const dur = 350; let st;
                    function step(ts){ if(!st) st = ts; const p=Math.min(1,(ts-st)/dur); const e = p<.5?4*p*p*p:1-Math.pow(-2*p+2,3)/2; messagesContainer.scrollTop = start + (end-start)*e; if(p<1) requestAnimationFrame(step); }
                    requestAnimationFrame(step);
                } catch { messagesContainer.scrollTop = messagesContainer.scrollHeight; }
            }
        }
        
        function sendMessage() {
            const input = document.getElementById('messageInput');
            const content = input.value.trim();
            
            if (content) {
                socket.emit('user_message', {
                    userId: userId,
                    content: content,
                    senderType: 'user'
                });
                
                // پیام کاربر از طریق game-client-simple.js نمایش داده می‌شود
                // addMessage('شما', content, 'user');
                input.value = '';
                hudMessageCount++;
            }
        }
        
