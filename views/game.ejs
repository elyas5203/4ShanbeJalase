                <div id="videoContainer" style="display: none; text-align: center; margin: 20px 0;">
                    <video id="hackVideo" class="hack-video" controls preload="auto" playsinline controlslist="nodownload noplaybackrate nocast" disablepictureinpicture oncontextmenu="return false;" style="object-fit: contain; background: black;" referrerpolicy="no-referrer">
                        <source src="/hvideo/hack" type="video/mp4">
                        مرورگر شما از پخش ویدیو پشتیبانی نمی‌کند.
