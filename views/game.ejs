        <!-- مرحله ترمینال -->
        <div id="terminalStage" class="terminal-stage">
            <div class="hack-terminal">
                <div class="terminal-header">🔴 SYSTEM COMPROMISED - UNAUTHORIZED ACCESS DETECTED 🔴</div>
