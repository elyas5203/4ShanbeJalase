                  <div class="aftermath" id="aftermath">
                    <div>
                      <div class="eye-wrap">
                        <div class="eye"></div>
                        <div class="iris"></div>
                        <div class="scanlines"></div>
                      </div>
                      <div class="messages">
                        <div class="msg" id="msg1"></div>
                        <div class="msg" id="msg2"></div>
