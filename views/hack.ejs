<script>
// ========== GLOBAL VARIABLES ==========
let scene, camera, renderer, mask;
let veinsCanvas, veinsCtx;
let socket;
let audioContext, noiseBuffer;
let sequenceActive = false;

// ========== AUDIO SYSTEM ==========
function initAudio() {
  try {
    audioContext = new (window.AudioContext || window.webkitAudioContext)();
    
    // Create noise buffer
    const bufferSize = audioContext.sampleRate * 0.5;
    noiseBuffer = audioContext.createBuffer(1, bufferSize, audioContext.sampleRate);
    const output = noiseBuffer.getChannelData(0);
    
    for (let i = 0; i < bufferSize; i++) {
      output[i] = Math.random() * 2 - 1;
    }
  } catch (e) {
    console.log('Audio not supported');
  }
}

function playGlitchSound() {
  if (!audioContext || !noiseBuffer) return;
  
  const source = audioContext.createBufferSource();
  const gainNode = audioContext.createGain();
  
  source.buffer = noiseBuffer;
  source.connect(gainNode);
  gainNode.connect(audioContext.destination);
  
  gainNode.gain.setValueAtTime(0.1, audioContext.currentTime);
  gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.5);
  
  source.start();
  source.stop(audioContext.currentTime + 0.5);
}

// ========== 3D HACKER MASK (پروتوتایپ 3) ==========
function init3DMask() {
  const canvas = document.getElementById('threejs-canvas');
  
  // Scene setup
  scene = new THREE.Scene();
  camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
  renderer = new THREE.WebGLRenderer({ canvas: canvas, alpha: true });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setClearColor(0x000000, 0);
  
  // Lighting
  const ambientLight = new THREE.AmbientLight(0x404040, 0.3);
  scene.add(ambientLight);
  
  const directionalLight = new THREE.DirectionalLight(0xff0000, 1);
  directionalLight.position.set(0, 1, 1);
  scene.add(directionalLight);
  
  // Create mask geometry
  const geometry = new THREE.SphereGeometry(2, 32, 32);
  
  // Create mask material with red glow
  const material = new THREE.MeshPhongMaterial({
    color: 0x330000,
    emissive: 0x110000,
    shininess: 100,
    transparent: true,
    opacity: 0.9
  });
  
  mask = new THREE.Mesh(geometry, material);
  
  // Add face features (eyes, mouth)
  const eyeGeometry = new THREE.SphereGeometry(0.2, 16, 16);
  const eyeMaterial = new THREE.MeshBasicMaterial({ 
    color: 0xff0000,
    emissive: 0xff0000,
    emissiveIntensity: 0.5
  });
  
  const leftEye = new THREE.Mesh(eyeGeometry, eyeMaterial);
  leftEye.position.set(-0.5, 0.3, 1.8);
  mask.add(leftEye);
  
  const rightEye = new THREE.Mesh(eyeGeometry, eyeMaterial);
  rightEye.position.set(0.5, 0.3, 1.8);
  mask.add(rightEye);
  
  // Mouth
  const mouthGeometry = new THREE.TorusGeometry(0.3, 0.1, 8, 16);
  const mouthMaterial = new THREE.MeshBasicMaterial({ 
    color: 0x000000,
    transparent: true,
    opacity: 0.8
  });
  const mouth = new THREE.Mesh(mouthGeometry, mouthMaterial);
  mouth.position.set(0, -0.5, 1.8);
  mouth.rotation.x = Math.PI / 2;
  mask.add(mouth);
  
  scene.add(mask);
  
  // Position camera far away initially
  camera.position.z = 50;
  
  // Animation loop
  function animate() {
    requestAnimationFrame(animate);
    
    if (mask) {
      mask.rotation.y += 0.005;
      mask.rotation.x = Math.sin(Date.now() * 0.001) * 0.1;
    }
    
    renderer.render(scene, camera);
  }
  animate();
  
  // Handle window resize
  window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  });
}

// ========== VEINS SYSTEM (پروتوتایپ 2) ==========
function initVeins() {
  veinsCanvas = document.getElementById('veins-canvas');
  veinsCtx = veinsCanvas.getContext('2d');
  
  function resize() {
    veinsCanvas.width = window.innerWidth;
    veinsCanvas.height = window.innerHeight;
  }
  resize();
  window.addEventListener('resize', resize);
  
  const veins = [];
  const maxVeins = 25;
  
  class Vein {
    constructor() {
      this.reset();
    }
    
    reset() {
      this.x = Math.random() * veinsCanvas.width;
      this.y = Math.random() * veinsCanvas.height;
      this.targetX = Math.random() * veinsCanvas.width;
      this.targetY = Math.random() * veinsCanvas.height;
      this.progress = 0;
      this.speed = 0.001 + Math.random() * 0.002;
      this.opacity = 0.1 + Math.random() * 0.3;
      this.thickness = 1 + Math.random() * 3;
      this.color = Math.random() > 0.7 ? '#b3122e' : '#ff1e2f';
    }
    
    update() {
      this.progress += this.speed;
      if (this.progress >= 1) {
        this.reset();
      }
    }
    
    draw() {
      const currentX = this.x + (this.targetX - this.x) * this.progress;
      const currentY = this.y + (this.targetY - this.y) * this.progress;
      
      veinsCtx.strokeStyle = this.color + Math.floor(this.opacity * 255).toString(16).padStart(2, '0');
      veinsCtx.lineWidth = this.thickness;
      veinsCtx.beginPath();
      veinsCtx.moveTo(this.x, this.y);
      veinsCtx.lineTo(currentX, currentY);
      veinsCtx.stroke();
      
      // Add glow effect
      veinsCtx.shadowColor = this.color;
      veinsCtx.shadowBlur = 10;
      veinsCtx.stroke();
      veinsCtx.shadowBlur = 0;
    }
  }
  
  // Initialize veins
  for (let i = 0; i < maxVeins; i++) {
    veins.push(new Vein());
  }
  
  function animateVeins() {
    veinsCtx.fillStyle = 'rgba(5, 6, 7, 0.02)';
    veinsCtx.fillRect(0, 0, veinsCanvas.width, veinsCanvas.height);
    
    veins.forEach(vein => {
      vein.update();
      vein.draw();
    });
    
    requestAnimationFrame(animateVeins);
  }
  animateVeins();
}

// ========== HACKER CHAT SYSTEM ==========
function initHackerChat() {
  socket = io();
  
  socket.on('new_message', (messageData) => {
    if (messageData.sender_type === 'admin' && sequenceActive) {
      displayHackerMessage(messageData.content);
    }
  });
}

function displayHackerMessage(message) {
  const chatMessages = document.getElementById('chatMessages');
  const messageDiv = document.createElement('div');
  messageDiv.className = 'hacker-message';
  
  // Add scramble effect
  messageDiv.innerHTML = `<span class="scramble" data-text="${message}">${message}</span>`;
  
  chatMessages.appendChild(messageDiv);
  
  // Animate message appearance
  setTimeout(() => {
    messageDiv.classList.add('visible');
  }, 100);
  
  // Auto scroll
  chatMessages.scrollTop = chatMessages.scrollHeight;
  
  // Play sound
  playGlitchSound();
}

// ========== MAIN SEQUENCE ==========
function beginHackSequence() {
  console.log('🔴 HACK SEQUENCE INITIATED');
  sequenceActive = true;
  
  const initialUI = document.getElementById('initialUI');
  const panel = document.getElementById('panel');
  const glitchOverlay = document.getElementById('glitchOverlay');
  const veinsCanvas = document.getElementById('veins-canvas');
  const threejsCanvas = document.getElementById('threejs-canvas');
  const blackout = document.getElementById('blackout');
  const hackerChat = document.getElementById('hackerChat');
  const finalMessage = document.getElementById('finalMessage');
  
  // Phase 1: Initial corruption (0-3s)
  setTimeout(() => {
    playGlitchSound();
    glitchOverlay.classList.add('active');
    initialUI.classList.add('shake');
    panel.classList.add('shake');
  }, 500);
  
  // Phase 2: Veins activation (2-5s)
  setTimeout(() => {
    veinsCanvas.classList.add('active');
    initialUI.classList.add('corrode');
    panel.classList.add('corrode');
  }, 2000);
  
  // Phase 3: 3D Mask appears (4-8s)
  setTimeout(() => {
    threejsCanvas.classList.add('visible');
    
    // Animate camera zoom to mask
    gsap.to(camera.position, {
      duration: 4,
      z: 5,
      ease: "power2.inOut"
    });
    
    // Intensify mask glow
    gsap.to(mask.material, {
      duration: 4,
      emissiveIntensity: 0.3,
      ease: "power2.inOut"
    });
  }, 4000);
  
  // Phase 4: System takeover (8-10s)
  setTimeout(() => {
    blackout.classList.add('on');
    glitchOverlay.classList.remove('active');
  }, 8000);
  
  // Phase 5: Hacker chat activation (10s+)
  setTimeout(() => {
    blackout.classList.remove('on');
    hackerChat.classList.add('active');
    
    // Show initial hacker message
    setTimeout(() => {
      displayHackerMessage("SYSTEM BREACHED... WELCOME TO MY DOMAIN");
    }, 1000);
    
    setTimeout(() => {
      displayHackerMessage("YOUR SECURITY WAS... INADEQUATE");
    }, 3000);
    
    setTimeout(() => {
      displayHackerMessage("I AM IN CONTROL NOW...");
    }, 5000);
  }, 10000);
  
  // Phase 6: Final message (15s)
  setTimeout(() => {
    finalMessage.classList.add('on');
  }, 15000);
}

// ========== INITIALIZATION ==========
window.addEventListener('load', () => {
  console.log('🔴 Hack sequence page loaded');
  
  initAudio();
  init3DMask();
  initVeins();
  initHackerChat();
  
  // Start sequence automatically
  setTimeout(beginHackSequence, 1000);
});
</script>
