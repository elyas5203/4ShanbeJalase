<style>
:root {
  --bg: #020202;
  --crt-green: #19ff6a;
  --alert-red: #ff1e2f;
  --infect: #b3122e;
  --accent: #8cffd4;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

html, body {
  height: 100%;
  background: radial-gradient(1200px 600px at 20% 10%, #0c0f12 0%, #050607 60%, #000 100%);
  color: #e7f7ef;
  font-family: "Consolas", "Fira Code", monospace;
  overflow: hidden;
  cursor: none;
}

/* ========== CRT و SCANLINES (پروتوتایپ 1) ========== */
.stage {
  position: relative;
  height: 100%;
  overflow: hidden;
}

.scanlines::before {
  content: "";
  position: absolute;
  inset: 0;
  background: 
    linear-gradient(rgba(0,0,0,0.05), rgba(0,0,0,0.05)) repeat,
    repeating-linear-gradient(
      to bottom,
      rgba(255,255,255,0.03) 0px,
      rgba(255,255,255,0.03) 2px,
      transparent 3px,
      transparent 6px
    );
  mix-blend-mode: overlay;
  pointer-events: none;
  animation: scanflow 8s linear infinite;
}

@keyframes scanflow {
  0% { transform: translateY(0); }
  100% { transform: translateY(8px); }
}

/* ========== 3D CANVAS برای ماسک (پروتوتایپ 3) ========== */
#threejs-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 10;
  opacity: 0;
  transition: opacity 2s ease-in-out;
}

#threejs-canvas.visible {
  opacity: 1;
}

/* ========== VEINS CANVAS برای ویروس (پروتوتایپ 2) ========== */
#veins-canvas {
  position: absolute;
  inset: 0;
  z-index: 5;
  filter: blur(0.6px) contrast(120%);
  opacity: 0;
  transition: opacity 3s ease-in-out;
}

#veins-canvas.active {
  opacity: 1;
}

/* ========== UI اولیه ========== */
.initial-ui {
  position: absolute;
  top: 8%;
  left: 10%;
  right: 10%;
  display: flex;
  gap: 16px;
  align-items: center;
  justify-content: space-between;
  padding: 18px 22px;
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.06);
  backdrop-filter: blur(6px);
  z-index: 15;
  transition: all 1s ease;
}

.panel {
  position: absolute;
  bottom: 12%;
  left: 12%;
  width: 28%;
  height: 38%;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.06);
  backdrop-filter: blur(6px);
  padding: 16px;
  overflow: hidden;
  z-index: 15;
  transition: all 1s ease;
}

/* ========== GLITCH EFFECTS (پروتوتایپ 1) ========== */
.glitch-overlay {
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0;
  mix-blend-mode: screen;
  background: repeating-linear-gradient(
    0deg,
    rgba(255,0,0,0.08) 0 2px,
    rgba(0,255,0,0.08) 2px 4px,
    rgba(0,0,255,0.08) 4px 6px
  );
  filter: contrast(140%) saturate(140%);
  z-index: 50;
}

.glitch-overlay.active {
  animation: glitchPulse 0.9s ease-in-out infinite;
  opacity: 1;
}

@keyframes glitchPulse {
  0% { opacity: 0; }
  8% { opacity: 1; transform: translate(-3px, 2px); }
  18% { transform: translate(4px, -3px); }
  32% { clip-path: inset(30% 0 0 0); }
  46% { clip-path: inset(0 0 60% 0); transform: translate(-6px, 1px); }
  62% { filter: hue-rotate(40deg) contrast(200%); }
  78% { transform: translate(7px, -2px) scale(1.02); }
  92% { clip-path: inset(0 0 0 0); }
  100% { opacity: 1; transform: none; }
}

.shake {
  animation: shake 0.6s cubic-bezier(0.36, 0.07, 0.19, 0.97) infinite;
}

@keyframes shake {
  10%, 90% { transform: translate3d(-1px, 0, 0); }
  20%, 80% { transform: translate3d(2px, 0, 0); }
  30%, 50%, 70% { transform: translate3d(-4px, 0, 0); }
  40%, 60% { transform: translate3d(4px, 0, 0); }
}

/* ========== CORRODE EFFECT (پروتوتایپ 2) ========== */
.corrode {
  animation: corrode 5s ease-in forwards;
}

@keyframes corrode {
  0% { filter: none; }
  100% {
    opacity: 0;
    transform: translateY(40px) skewX(-6deg);
    filter: blur(6px);
  }
}

/* ========== BLACKOUT ========== */
.blackout {
  position: absolute;
  inset: 0;
  background: #000;
  opacity: 0;
  pointer-events: none;
  z-index: 60;
  transition: opacity 0.3s ease-in;
}

.blackout.on {
  opacity: 1;
}

/* ========== HACKER CHAT ========== */
.hacker-chat {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 200px;
  background: linear-gradient(
    to top,
    rgba(0,0,0,0.9) 0%,
    rgba(0,0,0,0.7) 50%,
    transparent 100%
  );
  border-top: 2px solid var(--alert-red);
  padding: 20px;
  z-index: 70;
  opacity: 0;
  transform: translateY(100%);
  transition: all 1s ease;
}

.hacker-chat.active {
  opacity: 1;
  transform: translateY(0);
}

.chat-header {
  color: var(--alert-red);
  font-size: 14px;
  margin-bottom: 10px;
  text-transform: uppercase;
  letter-spacing: 2px;
  animation: pulse-red 2s infinite;
}

@keyframes pulse-red {
  0%, 100% { opacity: 0.7; }
  50% { opacity: 1; text-shadow: 0 0 10px var(--alert-red); }
}

.chat-messages {
  height: 120px;
  overflow-y: auto;
  font-family: "Courier New", monospace;
  font-size: 13px;
  line-height: 1.4;
}

.hacker-message {
  margin-bottom: 8px;
  color: var(--crt-green);
  opacity: 0;
  transform: translateX(-20px);
}

.hacker-message.visible {
  opacity: 1;
  transform: translateX(0);
  transition: all 0.5s ease;
}

/* ========== SCRAMBLE TEXT EFFECT ========== */
.scramble {
  position: relative;
  display: inline-block;
}

.scramble::before {
  content: attr(data-text);
  position: absolute;
  top: 0;
  left: 0;
  animation: scramble 0.8s ease-in-out;
}

@keyframes scramble {
  0% { content: "████████████████"; }
  10% { content: "█▓▒░████████████"; }
  20% { content: "██▓▒░███████████"; }
  30% { content: "███▓▒░██████████"; }
  40% { content: "████▓▒░█████████"; }
  50% { content: "█████▓▒░████████"; }
  60% { content: "██████▓▒░███████"; }
  70% { content: "███████▓▒░██████"; }
  80% { content: "████████▓▒░█████"; }
  90% { content: "█████████▓▒░████"; }
  100% { content: attr(data-text); }
}

/* ========== FINAL MESSAGE ========== */
.final-message {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  opacity: 0;
  color: var(--alert-red);
  font-size: clamp(24px, 6vw, 64px);
  letter-spacing: 0.08em;
  text-shadow: 
    0 0 12px rgba(255,30,47,0.6),
    0 0 32px rgba(255,30,47,0.4);
  z-index: 80;
}

.final-message.on {
  opacity: 1;
  transition: opacity 0.4s ease-in 0.2s;
