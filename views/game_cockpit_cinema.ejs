<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>کاکپیت سینمایی کارآگاهی</title>
    
    <!-- Three.js for 3D Earth -->
    <script src="https://cdn.jsdelivr.net/npm/three@0.158.0/build/three.min.js"></script>
    
    <!-- DSEG7 Font for Digital Clock -->
    <style>
        @font-face { 
            font-family: 'DSEG7'; 
            src: url('https://cdn.jsdelivr.net/gh/keshikan/DSEG/assets/DSEG7-Classic/DSEG7Classic-Regular.woff2') format('woff2'); 
        }
    </style>
    
    <style>
        /* ========== ROOT VARIABLES ========== */
        :root {
            --bg-primary: #020309;
            --bg-secondary: #05070d;
            --bg-tertiary: #0a0f1f;
            --panel-bg: rgba(20, 35, 60, 0.35);
            --border-neon: rgba(90, 220, 255, 0.85);
            --glow: rgba(90, 220, 255, 0.35);
            --text: #d9f6ff;
            --accent: #75e5ff;
            --grid: rgba(140, 200, 255, 0.12);
            --chat-user: #a6ffe0;
            --chat-admin: #54ffbd;
        }

        /* ========== BASE STYLES ========== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
            font-family: ui-monospace, 'Courier New', monospace;
            background: radial-gradient(1200px circle at 60% 40%, var(--bg-tertiary) 0%, var(--bg-secondary) 40%, var(--bg-primary) 100%);
            color: var(--text);
            overflow: hidden;
        }

        /* ========== GRID BACKGROUND ========== */
        .bg-grid::before {
            content: "";
            position: fixed;
            inset: 0;
            background-image: 
                linear-gradient(var(--grid) 1px, transparent 1px),
                linear-gradient(90deg, var(--grid) 1px, transparent 1px);
            background-size: 24px 24px;
            mask-image: radial-gradient(800px circle at 50% 50%, rgba(0,0,0,0.9), transparent 75%);
            pointer-events: none;
            z-index: 0;
        }

        /* ========== MAIN LAYOUT ========== */
        .cockpit-container {
            display: grid;
            grid-template-rows: 80px 1fr;
            grid-template-columns: 15% 70% 15%;
            height: 100vh;
            gap: 10px;
            padding: 10px;
            position: relative;
            z-index: 1;
        }

        /* ========== HEADER (DIGITAL CLOCK) ========== */
        .header {
            grid-column: 1 / -1;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .clock-wrap {
            position: relative;
            padding: 16px 24px;
            border-radius: 12px;
            background: var(--panel-bg);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(120, 210, 255, 0.35);
            box-shadow: 
                0 0 0 1px var(--border-neon) inset,
                0 0 20px var(--glow);
        }

        .clock {
            font-family: 'DSEG7', monospace;
            font-size: 32px;
            letter-spacing: 0.06em;
            color: #9ff0ff;
            text-shadow: 
                0 0 6px rgba(120, 220, 255, 0.45),
                0 0 14px rgba(80, 200, 255, 0.25);
        }

        .clock .sep {
            animation: blink 1s steps(1, end) infinite;
        }

        @keyframes blink {
            0%, 49% { opacity: 1; }
            50%, 100% { opacity: 0.25; }
        }

        /* ========== RIGHT COLUMN (3D EARTH) ========== */
        .earth-column {
            grid-row: 2;
            grid-column: 3;
            position: relative;
            border-radius: 12px;
            background: var(--panel-bg);
            backdrop-filter: blur(14px);
            border: 1px solid rgba(120, 210, 255, 0.35);
            box-shadow: 
                0 0 0 1px var(--border-neon) inset,
                0 0 22px var(--glow);
            overflow: hidden;
        }

        #earth-canvas {
            width: 100%;
            height: 100%;
            display: block;
        }

        /* ========== CENTER COLUMN (CHAT) ========== */
        .chat-column {
            grid-row: 2;
            grid-column: 2;
            display: flex;
            flex-direction: column;
            border-radius: 12px;
            background: var(--panel-bg);
            backdrop-filter: blur(14px);
            border: 1px solid rgba(120, 210, 255, 0.35);
            box-shadow: 
                0 0 0 1px var(--border-neon) inset,
                0 0 22px var(--glow);
            overflow: hidden;
        }

        .chat-header {
            padding: 12px 16px;
            background: rgba(20, 35, 60, 0.5);
            border-bottom: 1px solid rgba(120, 210, 255, 0.2);
            font-size: 14px;
            font-weight: bold;
            text-align: center;
            color: var(--accent);
        }

        .chat-messages {
            flex: 1;
            padding: 16px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .message {
            max-width: 80%;
            padding: 8px 12px;
            border-radius: 12px;
            font-size: 14px;
            line-height: 1.4;
            white-space: pre-wrap;
            word-wrap: break-word;
        }

        .message.user {
            align-self: flex-end;
            background: rgba(166, 255, 224, 0.1);
            border: 1px solid rgba(166, 255, 224, 0.3);
            color: var(--chat-user);
        }

        .message.admin {
            align-self: flex-start;
            background: rgba(84, 255, 189, 0.1);
            border: 1px solid rgba(84, 255, 189, 0.3);
            color: var(--chat-admin);
        }

        .message.system {
            align-self: center;
            background: rgba(84, 255, 189, 0.05);
            border: 1px solid rgba(84, 255, 189, 0.1);
            color: var(--glow);
            font-style: italic;
            font-size: 12px;
        }

        .chat-input {
            padding: 16px;
            background: rgba(20, 35, 60, 0.5);
            border-top: 1px solid rgba(120, 210, 255, 0.2);
            display: flex;
            gap: 8px;
        }

        .chat-input textarea {
            flex: 1;
            padding: 8px 12px;
            background: rgba(20, 35, 60, 0.3);
            border: 1px solid rgba(120, 210, 255, 0.3);
            border-radius: 8px;
            color: var(--text);
            font-family: inherit;
            font-size: 14px;
            resize: vertical;
            min-height: 36px;
            max-height: 120px;
        }

        .chat-input textarea:focus {
            outline: none;
            border-color: var(--border-neon);
            box-shadow: 0 0 10px var(--glow);
        }

        .chat-input button {
            padding: 8px 16px;
            background: rgba(0, 255, 0, 0.2);
            border: 1px solid rgba(0, 255, 0, 0.5);
            border-radius: 8px;
            color: #00ff00;
            cursor: pointer;
            font-family: inherit;
            font-size: 12px;
            transition: all 0.3s ease;
        }

        .chat-input button:hover {
            background: rgba(0, 255, 0, 0.3);
            box-shadow: 0 0 10px rgba(0, 255, 0, 0.3);
        }

        /* ========== LEFT COLUMN (HUD WIDGETS) ========== */
        .hud-column {
            grid-row: 2;
            grid-column: 1;
            display: flex;
            flex-direction: column;
            gap: 12px;
            overflow-y: auto;
        }

        .hud-widget {
            padding: 12px;
            border-radius: 12px;
            background: var(--panel-bg);
            backdrop-filter: blur(14px);
            border: 1px solid rgba(120, 210, 255, 0.35);
            box-shadow: 
                0 0 0 1px var(--border-neon) inset,
                0 0 15px var(--glow);
            opacity: 0;
            transform: translateY(-8px) scale(0.98);
            animation: buildUp 900ms cubic-bezier(.22,.68,.13,1) forwards;
        }

        .hud-widget:nth-child(1) { animation-delay: 300ms; }
        .hud-widget:nth-child(2) { animation-delay: 500ms; }
        .hud-widget:nth-child(3) { animation-delay: 700ms; }
        .hud-widget:nth-child(4) { animation-delay: 900ms; }

        @keyframes buildUp {
            0% {
                opacity: 0;
                transform: translateY(-10px) scale(0.96);
            }
            60% {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
            100% {
                opacity: 1;
                transform: translateY(0) scale(1);
                filter: saturate(120%) brightness(1);
            }
        }

        .hud-title {
            font-size: 11px;
            color: var(--accent);
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .hud-content {
            font-size: 10px;
            line-height: 1.3;
            color: var(--text);
        }

        .hud-value {
            color: var(--accent);
            font-weight: bold;
        }

        .hud-bar {
            width: 100%;
            height: 4px;
            background: rgba(120, 210, 255, 0.2);
            border-radius: 2px;
            overflow: hidden;
            margin: 4px 0;
        }

        .hud-bar-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--accent), var(--border-neon));
            border-radius: 2px;
            transition: width 0.5s ease;
        }

        /* ========== RESPONSIVE DESIGN ========== */
        @media (max-width: 1200px) {
            .cockpit-container {
                grid-template-columns: 20% 60% 20%;
            }
        }

        @media (max-width: 900px) {
            .cockpit-container {
                grid-template-rows: 60px 1fr 200px;
                grid-template-columns: 1fr;
                gap: 8px;
            }
            
            .header {
                grid-column: 1;
                grid-row: 1;
            }
            
            .chat-column {
                grid-column: 1;
                grid-row: 2;
            }
            
            .earth-column,
            .hud-column {
                display: none;
            }
            
            .clock {
                font-size: 24px;
            }
        }

        /* ========== SCROLLBAR STYLING ========== */
        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: rgba(20, 35, 60, 0.3);
        }

        ::-webkit-scrollbar-thumb {
            background: var(--border-neon);
            border-radius: 3px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: var(--accent);
        }
    </style>
</head>
<body class="bg-grid">
    <div class="cockpit-container">
        <!-- Header with Digital Clock -->
        <div class="header">
            <div class="clock-wrap">
                <div id="clock" class="clock"></div>
            </div>
        </div>

        <!-- Right Column: 3D Earth -->
        <div class="earth-column">
            <canvas id="earth-canvas"></canvas>
        </div>

        <!-- Center Column: Chat -->
        <div class="chat-column">
            <div class="chat-header">
                ترمینال ارتباطات - جلسه فعال
            </div>
            <div class="chat-messages" id="chatMessages">
                <!-- Messages will be dynamically added here -->
            </div>
            <div class="chat-input">
                <textarea id="messageInput" placeholder="پیام خود را اینجا بنویسید..." rows="1"></textarea>
                <input type="file" id="fileInput" style="display: none;" accept="image/*,video/*,audio/*">
                <button onclick="document.getElementById('fileInput').click()">📎</button>
                <button id="sendButton">ارسال</button>
            </div>
        </div>

        <!-- Left Column: HUD Widgets -->
        <div class="hud-column">
            <div class="hud-widget">
                <div class="hud-title">وضعیت سیستم</div>
                <div class="hud-content">
                    CPU: <span class="hud-value" id="cpu-usage">45%</span>
                    <div class="hud-bar">
                        <div class="hud-bar-fill" style="width: 45%"></div>
                    </div>
                    RAM: <span class="hud-value" id="ram-usage">67%</span>
                    <div class="hud-bar">
                        <div class="hud-bar-fill" style="width: 67%"></div>
                    </div>
                    NET: <span class="hud-value">ONLINE</span>
                </div>
            </div>

            <div class="hud-widget">
                <div class="hud-title">اطلاعات ماموریت</div>
                <div class="hud-content">
                    فاز: <span class="hud-value">عادی</span><br>
                    وضعیت: <span class="hud-value">فعال</span><br>
                    پیشرفت: <span class="hud-value">78%</span>
                    <div class="hud-bar">
                        <div class="hud-bar-fill" style="width: 78%"></div>
                    </div>
                </div>
            </div>

            <div class="hud-widget">
                <div class="hud-title">آمار جلسه</div>
                <div class="hud-content">
                    پیام‌ها: <span class="hud-value" id="message-count">0</span><br>
                    مدت زمان: <span class="hud-value" id="session-time">00:00</span><br>
                    کاربران: <span class="hud-value">1</span>
                </div>
            </div>

            <div class="hud-widget">
                <div class="hud-title">امنیت</div>
                <div class="hud-content">
                    رمزنگاری: <span class="hud-value">فعال</span><br>
                    احراز هویت: <span class="hud-value">تأیید شده</span><br>
                    سطح دسترسی: <span class="hud-value">کاربر</span>
                </div>
            </div>
        </div>
    </div>

    <!-- User Variables -->
    <script>
        const userId = <%= userId %>;
        const username = '<%= username %>';
    </script>
    
    <script src="/socket.io/socket.io.js"></script>
    <script>
        // ========== DIGITAL CLOCK ========== 
        function pad(n) { 
            return n < 10 ? '0' + n : '' + n; 
        }
        
        function updateClock() { 
            const now = new Date();
            const h = pad(now.getHours());
            const m = pad(now.getMinutes());
            const s = pad(now.getSeconds());
            document.getElementById('clock').innerHTML = `${h}<span class="sep">:</span>${m}<span class="sep">:</span>${s}`;
            requestAnimationFrame(updateClock); 
        }
        updateClock();

        // ========== 3D EARTH ========== 
        let scene, camera, renderer, earthMesh;
        
        function initEarth() {
            const canvas = document.getElementById('earth-canvas');
            const container = canvas.parentElement;
            
            scene = new THREE.Scene();
            camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.1, 1000);
            camera.position.z = 3;
            
            renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: true });
            renderer.setSize(container.clientWidth, container.clientHeight);
            renderer.setClearColor(0x000000, 0);
            
            const ambient = new THREE.AmbientLight(0xffffff, 0.4);
            scene.add(ambient);
            
            const directional = new THREE.DirectionalLight(0xffffff, 1);
            directional.position.set(5, 3, 5);
            scene.add(directional);
            
            const loader = new THREE.TextureLoader();
            const earthTexture = loader.load("https://threejs.org/examples/textures/land_ocean_ice_cloud_2048.jpg");
            const earthMaterial = new THREE.MeshPhongMaterial({ map: earthTexture });
            const earthGeometry = new THREE.SphereGeometry(1, 64, 64);
            earthMesh = new THREE.Mesh(earthGeometry, earthMaterial);
            scene.add(earthMesh);
            
            animate();
        }
        
        function animate() {
            requestAnimationFrame(animate);
            if (earthMesh) {
                earthMesh.rotation.y += 0.002;
            }
            renderer.render(scene, camera);
        }
        
        // Handle resize
        window.addEventListener('resize', () => {
            const canvas = document.getElementById('earth-canvas');
            const container = canvas.parentElement;
            if (camera && renderer) {
                camera.aspect = container.clientWidth / container.clientHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(container.clientWidth, container.clientHeight);
            }
        });

        // ========== HUD UPDATES ========== 
        let messageCount = 0;
        let sessionStartTime = Date.now();
        
        function updateHUD() {
            // Update CPU/RAM randomly for demo
            const cpu = Math.floor(Math.random() * 30) + 30;
            const ram = Math.floor(Math.random() * 40) + 50;
            
            document.getElementById('cpu-usage').textContent = cpu + '%';
            document.querySelector('.hud-widget:nth-child(1) .hud-bar-fill').style.width = cpu + '%';
            
            document.getElementById('ram-usage').textContent = ram + '%';
            document.querySelector('.hud-widget:nth-child(1) .hud-bar:nth-child(4) .hud-bar-fill').style.width = ram + '%';
            
            // Update session time
            const elapsed = Math.floor((Date.now() - sessionStartTime) / 1000);
            const minutes = Math.floor(elapsed / 60);
            const seconds = elapsed % 60;
            document.getElementById('session-time').textContent = `${pad(minutes)}:${pad(seconds)}`;
            
            // Update message count
            document.getElementById('message-count').textContent = messageCount;
        }
        
        setInterval(updateHUD, 2000);

        // ========== CHAT FUNCTIONALITY ========== 
        let socket;
        
        function initChat() {
            socket = io({
                query: {
                    userId: userId,
                    username: username
                }
            });
            
            socket.on('connect', () => {
                console.log('🔗 متصل به سرور');
                addMessage('سیستم', 'اتصال برقرار شد', 'system');
            });
            
            socket.on('new_message', (messageData) => {
                addMessage(getSenderName(messageData.sender_type), messageData.content, messageData.sender_type);
                messageCount++;
            });
            
            socket.on('scrambled_message', (messageData) => {
                addMessage(getSenderName(messageData.sender_type), messageData.content, messageData.sender_type, true);
                messageCount++;
            });
        }
        
        function getSenderName(senderType) {
            const names = {
                'user': 'شما',
                'detective': 'کارآگاه',
                'hacker': 'هکر',
                'admin': 'مرکز فرماندهی'
            };
            return names[senderType] || senderType;
        }
        
        function addMessage(sender, content, type, isScrambled = false) {
            const messagesContainer = document.getElementById('chatMessages');
            const messageDiv = document.createElement('div');
            messageDiv.className = `message ${type}`;
            
            if (isScrambled) {
                messageDiv.innerHTML = `<strong>${sender}:</strong><br>█ █ █ █ █ █ █ █`;
                setTimeout(() => {
                    messageDiv.innerHTML = `<strong>${sender}:</strong><br>${content}`;
                }, 1000);
            } else {
                messageDiv.innerHTML = `<strong>${sender}:</strong><br>${content}`;
            }
            
            messagesContainer.appendChild(messageDiv);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }
        
        function sendMessage() {
            const input = document.getElementById('messageInput');
            const content = input.value.trim();
            
            if (content) {
                socket.emit('user_message', {
                    userId: userId,
                    content: content,
                    senderType: 'user'
                });
                
                addMessage('شما', content, 'user');
                input.value = '';
                messageCount++;
            }
        }
        
        // Event listeners
        document.getElementById('sendButton').addEventListener('click', sendMessage);
        document.getElementById('messageInput').addEventListener('keypress', (e) => {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendMessage();
            }
        });
        
        // File upload handling
        document.getElementById('fileInput').addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (file) {
                // Handle file upload logic here
                console.log('File selected:', file.name);
            }
        });

        // ========== INITIALIZATION ========== 
        document.addEventListener('DOMContentLoaded', () => {
            initEarth();
            initChat();
            updateHUD();
        });
    </script>
</body>
</html>
