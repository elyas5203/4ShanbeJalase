<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>پنل ادمین - کارآگاه سایبری</title>
    <style>
        /* ========== RESET & BASE STYLES ========== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #0a0a0a 0%, #1a1a2e 50%, #16213e 100%);
            color: #ffffff;
            overflow-x: hidden;
            transition: all 0.3s ease;
        }

        /* ========== HAMBURGER BUTTON ========== */
        #sidebar-toggle {
            position: fixed;
            top: 20px;
            left: 20px;
            z-index: 1001;
            background: rgba(0, 255, 255, 0.1);
            border: 2px solid #00ffff;
            color: #00ffff;
            font-size: 18px;
            width: 50px;
            height: 50px;
            border-radius: 10px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
            backdrop-filter: blur(10px);
        }

        #sidebar-toggle:hover {
            background: rgba(0, 255, 255, 0.2);
            transform: scale(1.05);
            box-shadow: 0 0 20px rgba(0, 255, 255, 0.3);
        }

        /* ========== SIDEBAR STYLES ========== */
        #admin-sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: 320px;
            height: 100vh;
            background: rgba(10, 10, 30, 0.95);
            backdrop-filter: blur(20px);
            border-right: 2px solid rgba(0, 255, 255, 0.3);
            z-index: 1000;
            transform: translateX(-100%);
            transition: transform 0.3s ease;
            overflow-y: auto;
            padding: 80px 0 20px 0;
        }

        body.sidebar-open #admin-sidebar {
            transform: translateX(0);
        }

        .sidebar-section {
            margin: 20px;
            padding: 15px;
            background: rgba(0, 255, 255, 0.05);
            border: 1px solid rgba(0, 255, 255, 0.2);
            border-radius: 10px;
        }

        .sidebar-title {
            color: #00ffff;
            font-size: 14px;
            font-weight: bold;
            margin-bottom: 10px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* ========== USER LIST ========== */
        #users-list {
            max-height: 300px;
            overflow-y: auto;
        }

        .user-item {
            padding: 10px;
            margin: 5px 0;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 13px;
        }

        .user-item:hover {
            background: rgba(0, 255, 255, 0.1);
            border-color: #00ffff;
            transform: translateX(5px);
        }

        .user-item.selected {
            background: rgba(0, 255, 255, 0.2);
            border-color: #00ffff;
            box-shadow: 0 0 10px rgba(0, 255, 255, 0.3);
        }

        .user-name {
            font-weight: bold;
            color: #ffffff;
        }

        .user-status {
            font-size: 11px;
            color: #aaaaaa;
            margin-top: 3px;
        }

        /* ========== CONTROLS ========== */
        .control-group {
            margin: 10px 0;
        }

        .control-label {
            display: block;
            color: #cccccc;
            font-size: 12px;
            margin-bottom: 5px;
        }

        select, input, button {
            width: 100%;
            padding: 8px;
            margin: 5px 0;
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(0, 255, 255, 0.3);
            border-radius: 5px;
            color: #ffffff;
            font-size: 12px;
        }

        button {
            background: rgba(0, 255, 255, 0.1);
            cursor: pointer;
            transition: all 0.3s ease;
        }

        button:hover {
            background: rgba(0, 255, 255, 0.2);
            box-shadow: 0 0 10px rgba(0, 255, 255, 0.3);
        }

        /* ========== MAIN CONTENT ========== */
        #main-content {
            margin-left: 0;
            padding: 20px;
            min-height: 100vh;
            transition: margin-left 0.3s ease;
        }

        body.sidebar-open #main-content {
            margin-left: 320px;
        }

        /* ========== CHAT CONTAINER ========== */
        #chat-container {
            background: rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(15px);
            border: 2px solid rgba(0, 255, 255, 0.3);
            border-radius: 15px;
            height: calc(100vh - 40px);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .chat-header {
            background: rgba(0, 255, 255, 0.1);
            padding: 15px 20px;
            border-bottom: 1px solid rgba(0, 255, 255, 0.3);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .chat-title {
            font-size: 18px;
            font-weight: bold;
            color: #00ffff;
        }

        .chat-info {
            font-size: 12px;
            color: #aaaaaa;
        }

        /* ========== MESSAGES AREA ========== */
        #messages {
            flex: 1;
            padding: 20px;
            overflow-y: auto;
            background: rgba(0, 0, 0, 0.2);
        }

        .message {
            margin: 10px 0;
            padding: 12px 15px;
            border-radius: 12px;
            max-width: 80%;
            word-wrap: break-word;
            animation: messageSlide 0.3s ease;
        }

        @keyframes messageSlide {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* User messages (left side) */
        .message.user {
            background: rgba(100, 100, 255, 0.2);
            border: 1px solid rgba(100, 100, 255, 0.3);
            margin-right: auto;
            border-bottom-left-radius: 4px;
        }

        /* Admin messages (right side) */
        .message.admin, .message.detective, .message.hacker {
            background: rgba(0, 255, 100, 0.2);
            border: 1px solid rgba(0, 255, 100, 0.3);
            margin-left: auto;
            border-bottom-right-radius: 4px;
        }

        .message.detective {
            background: rgba(255, 215, 0, 0.2);
            border-color: rgba(255, 215, 0, 0.3);
        }

        .message.hacker {
            background: rgba(255, 0, 100, 0.2);
            border-color: rgba(255, 0, 100, 0.3);
            animation: messageSlide 0.3s ease, hackGlow 2s infinite;
        }

        @keyframes hackGlow {
            0%, 100% { box-shadow: 0 0 5px rgba(255, 0, 100, 0.3); }
            50% { box-shadow: 0 0 15px rgba(255, 0, 100, 0.6); }
        }

        .message-header {
            font-size: 11px;
            opacity: 0.7;
            margin-bottom: 5px;
        }

        .message-content {
            font-size: 14px;
            line-height: 1.4;
        }

        .message-time {
            font-size: 10px;
            opacity: 0.5;
            margin-top: 5px;
        }

        /* ========== INPUT AREA ========== */
        .input-area {
            padding: 20px;
            background: rgba(0, 0, 0, 0.3);
            border-top: 1px solid rgba(0, 255, 255, 0.3);
        }

        .phase-indicator {
            margin-top: 10px;
            padding: 8px 12px;
            background: rgba(0, 255, 255, 0.1);
            border: 1px solid rgba(0, 255, 255, 0.3);
            border-radius: 5px;
            font-size: 12px;
            color: #00ffff;
            text-align: center;
        }

        #current-character {
            font-weight: bold;
            color: #ffffff;
        }

        .input-controls {
            display: flex;
            gap: 10px;
            margin-bottom: 10px;
        }

        #sender-type {
            flex: 1;
        }

        #file-input {
            display: none;
        }

        .file-button {
            background: rgba(255, 165, 0, 0.2);
            border-color: rgba(255, 165, 0, 0.5);
            color: #ffaa00;
            padding: 8px 15px;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .file-button:hover {
            background: rgba(255, 165, 0, 0.3);
            box-shadow: 0 0 10px rgba(255, 165, 0, 0.3);
        }

        .message-input-row {
            display: flex;
            gap: 10px;
        }

        #message-input {
            flex: 1;
            padding: 12px;
            background: rgba(0, 0, 0, 0.5);
            border: 2px solid rgba(0, 255, 255, 0.3);
            border-radius: 10px;
            color: #ffffff;
            font-size: 14px;
            resize: none;
            min-height: 45px;
            max-height: 120px;
        }

        #message-input:focus {
            outline: none;
            border-color: #00ffff;
            box-shadow: 0 0 15px rgba(0, 255, 255, 0.3);
        }

        #send-button {
            background: rgba(0, 255, 0, 0.2);
            border-color: rgba(0, 255, 0, 0.5);
            color: #00ff00;
            padding: 12px 20px;
            border-radius: 10px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        #send-button:hover {
            background: rgba(0, 255, 0, 0.3);
            box-shadow: 0 0 15px rgba(0, 255, 0, 0.3);
        }

        /* ========== RESPONSIVE DESIGN ========== */
        @media (min-width: 900px) {
            /* Desktop: Sidebar open by default */
            #admin-sidebar {
                transform: translateX(0);
            }
            
            #main-content {
                margin-left: 320px;
            }
            
            body.sidebar-closed #admin-sidebar {
                transform: translateX(-100%);
            }
            
            body.sidebar-closed #main-content {
                margin-left: 0;
            }
            
            /* بهبود اندازه چت در دسکتاپ */
            #chat-container {
                height: calc(100vh - 20px);
                min-height: 600px;
            }
            
            #messages {
                min-height: 400px;
            }
        }

        @media (max-width: 899px) {
            /* Mobile: Sidebar closed by default */
            #admin-sidebar {
                width: 280px;
            }
            
            body.sidebar-open #main-content {
                margin-left: 0;
            }
            
            .message {
                max-width: 90%;
            }
            
            .input-controls {
                flex-direction: column;
            }
            
            .message-input-row {
                flex-direction: column;
            }
        }

        /* ========== IMAGE MODAL ========== */
        .image-modal {
            display: none;
            position: fixed;
            z-index: 2000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.9);
            backdrop-filter: blur(10px);
        }

        .image-modal.show {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .modal-content {
            max-width: 90%;
            max-height: 90%;
            border-radius: 10px;
            box-shadow: 0 0 30px rgba(0, 255, 255, 0.5);
        }

        .close-modal {
            position: absolute;
            top: 20px;
            right: 30px;
            color: #ffffff;
            font-size: 40px;
            cursor: pointer;
            z-index: 2001;
        }

        /* ========== SCROLLBAR STYLING ========== */
        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.3);
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb {
            background: rgba(0, 255, 255, 0.3);
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: rgba(0, 255, 255, 0.5);
        }
    </style>
</head>
<body>
    <!-- Hamburger Toggle Button -->
    <button id="sidebar-toggle">☰</button>

    <!-- Collapsible Sidebar -->
    <aside id="admin-sidebar">
        <!-- Users Section -->
        <div class="sidebar-section">
            <div class="sidebar-title">👥 کاربران فعال</div>
            <div id="users-list">
                <div class="user-item" data-user-id="loading">
                    <div class="user-name">در حال بارگذاری کاربران...</div>
                    <div class="user-status">لطفاً صبر کنید</div>
                </div>
            </div>
        </div>

        <!-- Mission Controls -->
        <div class="sidebar-section">
            <div class="sidebar-title">🎯 کنترل ماموریت</div>
            <div class="control-group">
                <label class="control-label">فاز فعلی:</label>
                <select id="phase-selector">
                    <option value="normal">🔍 تحقیق عادی</option>
                    <option value="hacker">💀 حمله هکر</option>
                    <option value="senior">👨‍💼 کارآگاه ارشد</option>
                </select>
            </div>
            <button id="change-phase-btn">🔄 تغییر فاز</button>
        </div>

        <!-- Quick Actions -->
        <div class="sidebar-section">
            <div class="sidebar-title">⚡ اقدامات سریع</div>
            <button id="broadcast-btn">📢 پخش عمومی</button>
            <button id="clear-chat-btn">🗑️ پاک کردن چت</button>
            <button id="export-logs-btn">📋 صدور گزارش</button>
        </div>

        <!-- File Upload -->
        <div class="sidebar-section">
            <div class="sidebar-title">📎 اشتراک فایل</div>
            <input type="file" id="file-input" accept="image/*,video/*,audio/*,.pdf,.doc,.docx">
            <button class="file-button" onclick="document.getElementById('file-input').click()">
                📁 انتخاب فایل
            </button>
            <div id="file-status" style="font-size: 11px; color: #aaa; margin-top: 5px;"></div>
        </div>
    </aside>

    <!-- Main Content Area -->
    <main id="main-content">
        <div id="chat-container">
            <!-- Chat Header -->
            <div class="chat-header">
                <div class="chat-title">🎮 مرکز فرماندهی کارآگاهی</div>
                <div class="chat-info" id="chat-info">یک کاربر را برای شروع چت انتخاب کنید</div>
            </div>

            <!-- Messages Area -->
            <div id="messages"></div>

            <!-- Input Area -->
            <div class="input-area">
                <div class="message-input-row">
                    <textarea id="message-input" placeholder="پیام خود را اینجا تایپ کنید..." rows="1"></textarea>
                    <button id="send-button">📡 ارسال</button>
                </div>
                <div class="phase-indicator" id="phase-indicator">
                    <span>شخصیت فعلی: </span><span id="current-character">کارآگاه</span>
                </div>
            </div>
        </div>
    </main>

    <!-- Image Modal -->
    <div id="image-modal" class="image-modal">
        <span class="close-modal">&times;</span>
        <img class="modal-content" id="modal-image">
    </div>

    <!-- Socket.IO and Admin Client Script -->
    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/admin-client.js"></script>
</body>
</html>
