<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>مرکز فرماندهی کارآگاهی - نسخه سینمایی</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <style>
        @font-face {
            font-family: 'Cyber';
            src: url('https://fonts.gstatic.com/s/rajdhani/v15/LDI1apSQZfxoacVKp7Q.ttf') format('truetype');
            font-weight: 600;
            font-style: normal;
        }

        :root {
            --bg-start: #0b0f14;
            --bg-end: #0f1420;
            --text: #d7e9ff;
            --muted: #9fb6d6;
            --accent: #6cf1ff;
            --accent-2: #66ffcc;
            --glass-bg: rgba(255,255,255,0.06);
            --glass-border: rgba(173, 216, 230, 0.5);
            --scanline: rgba(108,241,255,0.65);
            --rainbow-a: rgba(255, 0, 153, 0.15);
            --rainbow-b: rgba(0, 204, 255, 0.15);
            --rainbow-c: rgba(153, 255, 102, 0.15);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        html, body {
            height: 100%;
            background: linear-gradient(120deg, var(--bg-start), var(--bg-end));
            color: var(--text);
            font-family: 'Cyber', system-ui, sans-serif;
            overflow: hidden;
        }

        /* Neural Network Background */
        .neural-bg {
            position: absolute;
            inset: 0;
            background:
                radial-gradient(900px 400px at 40% 70%, rgba(108,241,255,0.08), transparent 65%),
                radial-gradient(600px 300px at 60% 30%, rgba(153,255,102,0.06), transparent 65%);
            filter: blur(2px);
            animation: breathe 8s ease-in-out infinite;
            opacity: 0.6;
            pointer-events: none;
        }

        @keyframes breathe {
            0%,100% { transform: scale(1); }
            50% { transform: scale(1.03); }
        }

        /* Main Layout */
        .layout {
            height: 100%;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0;
            position: relative;
        }

        .pane {
            position: relative;
            padding: 32px;
            overflow: hidden;
        }

        .pane.left {
            background: radial-gradient(800px 400px at 20% 20%, rgba(108,241,255,0.12), transparent 60%);
            border-right: 1px solid rgba(255,255,255,0.06);
        }

        .pane.right {
            background: radial-gradient(800px 400px at 80% 80%, rgba(102,255,204,0.12), transparent 60%);
        }

        /* Data Stream Section */
        .data-stream-header {
            margin-bottom: 24px;
        }

        .stream-title {
            font-size: 24px;
            font-weight: 700;
            color: var(--accent);
            text-shadow: 0 0 14px rgba(108,241,255,0.65);
            margin-bottom: 8px;
        }

        .stream-subtitle {
            font-size: 14px;
            color: var(--muted);
            letter-spacing: 0.8px;
        }

        .messages-container {
            height: calc(100vh - 200px);
            overflow-y: auto;
            padding-right: 10px;
            margin-bottom: 20px;
        }

        /* Data Card Styles (from prototype 1) */
        .data-card {
            position: relative;
            width: 100%;
            max-width: 460px;
            padding: 18px 20px 20px 20px;
            margin-bottom: 16px;
            border-radius: 16px;
            background: linear-gradient(120deg, rgba(255,255,255,0.08), rgba(255,255,255,0.02));
            backdrop-filter: blur(18px) saturate(120%);
            -webkit-backdrop-filter: blur(18px) saturate(120%);
            border: 1px solid rgba(255,255,255,0.12);
            outline: 1px solid var(--glass-border);
            box-shadow:
                0 0 0.5px 1px rgba(102,255,204,0.08) inset,
                0 0 28px rgba(102,255,204,0.12),
                0 6px 40px rgba(0,0,0,0.45);
            overflow: hidden;
            opacity: 0;
            transform: translateY(12px) scale(0.98);
            animation: rise-in 500ms 180ms ease-out forwards;
        }

        .data-card::before {
            content: "";
            position: absolute;
            inset: 0;
            border-radius: 16px;
            padding: 1px;
            background: radial-gradient(250px 250px at 8% -10%, rgba(102,255,204,0.35), transparent 60%),
                        radial-gradient(200px 200px at 92% 110%, rgba(108,241,255,0.25), transparent 60%);
            mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            -webkit-mask-composite: xor;
                    mask-composite: exclude;
            pointer-events: none;
        }

        .reveal-mask {
            position: absolute;
            inset: 0;
            background: linear-gradient(to bottom,
                transparent 0%,
                transparent var(--pos, 0%),
                rgba(255,255,255,0.02) calc(var(--pos, 0%) + 0.001%),
                rgba(255,255,255,0.09) calc(var(--pos, 0%) + 0.8%),
                rgba(255,255,255,0.03) calc(var(--pos, 0%) + 1.6%),
                transparent calc(var(--pos, 0%) + 2.2%),
                transparent 100%
            );
            mix-blend-mode: screen;
            pointer-events: none;
            filter: drop-shadow(0 0 8px var(--scanline));
            opacity: 0;
            animation: scanline 1100ms 300ms cubic-bezier(.17,.67,.25,1) forwards;
        }

        @keyframes scanline {
            0%   { --pos: 0%; opacity: 0; }
            10%  { opacity: 0.65; }
            50%  { --pos: 45%; opacity: 0.85; }
            100% { --pos: 100%; opacity: 0; }
        }

        @keyframes rise-in {
            to {
                opacity: 1;
                transform: translateY(0px) scale(1);
            }
        }

        .build-line {
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(108,241,255,0.8), transparent);
            opacity: 0;
            transform: scaleX(0.3);
            animation: build 700ms 600ms ease-out forwards;
        }

        @keyframes build {
            40% { opacity: 0.8; transform: scaleX(1); }
            100% { opacity: 0.2; transform: scaleX(1); }
        }

        .card-row {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-top: 12px;
            opacity: 0;
            transform: translateY(8px);
        }

        .card-row:nth-of-type(1) { animation: row-in 500ms 550ms ease-out forwards; }
        .card-row:nth-of-type(2) { animation: row-in 500ms 650ms ease-out forwards; }
        .card-row:nth-of-type(3) { animation: row-in 500ms 750ms ease-out forwards; }

        @keyframes row-in {
            to { opacity: 1; transform: translateY(0); }
        }

        .type-icon {
            width: 32px;
            height: 32px;
            display: grid;
            place-items: center;
            border-radius: 10px;
            background: radial-gradient(120px 80px at 30% 30%, rgba(102,255,204,0.25), transparent 60%),
                        linear-gradient(180deg, rgba(255,255,255,0.06), rgba(255,255,255,0.02));
            border: 1px solid rgba(255,255,255,0.12);
            color: var(--accent);
            text-shadow: 0 0 6px rgba(108,241,255,0.5);
            box-shadow: inset 0 0 10px rgba(108,241,255,0.15);
            font-weight: 700;
        }

        .meta {
            display: flex;
            gap: 10px;
            font-size: 12px;
            color: var(--muted);
            letter-spacing: 0.8px;
        }

        .card-line {
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.18), transparent);
        }

        .card-text {
            font-size: 14px;
            line-height: 1.4;
            color: var(--text);
            letter-spacing: 0.2px;
            text-shadow: 0 0 10px rgba(0,0,0,0.3);
            white-space: pre-wrap;
        }

        /* Evidence Wall (Right Panel) */
        .evidence-header {
            margin-bottom: 24px;
        }

        .evidence-title {
            font-size: 24px;
            font-weight: 700;
            color: #aeeaff;
            text-shadow: 0 0 14px rgba(108,241,255,0.65);
            margin-bottom: 8px;
        }

        .evidence-subtitle {
            font-size: 14px;
            color: var(--muted);
            letter-spacing: 0.8px;
        }

        .evidence-grid {
            display: grid;
            gap: 16px;
            height: calc(100vh - 200px);
            overflow-y: auto;
        }

        /* Holographic Card (from prototype 2) */
        .holo-card {
            position: relative;
            width: 100%;
            height: 200px;
            border-radius: 18px;
            background:
                linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0.02)),
                conic-gradient(from 0deg, var(--rainbow-a), var(--rainbow-b), var(--rainbow-c), var(--rainbow-b), var(--rainbow-a));
            background-blend-mode: screen;
            animation: hueShift 12s linear infinite;
            backdrop-filter: blur(18px) saturate(120%);
            -webkit-backdrop-filter: blur(18px) saturate(120%);
            border: 1px solid rgba(255,255,255,0.12);
            outline: 1px solid rgba(108,241,255,0.35);
            box-shadow:
                0 20px 60px rgba(0, 0, 0, 0.6),
                inset 0 0 30px rgba(255,255,255,0.06);
            transform-style: preserve-3d;
            transition: box-shadow 180ms ease;
            overflow: hidden;
            opacity: 0;
            transform: scale(0.94);
        }

        @keyframes hueShift {
            0% { filter: hue-rotate(0deg) saturate(1.05); }
            50% { filter: hue-rotate(90deg) saturate(1.1); }
            100% { filter: hue-rotate(180deg) saturate(1.05); }
        }

        .holo-card::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image:
                radial-gradient(2px 2px at 10px 10px, rgba(255,255,255,0.08), transparent 40%),
                linear-gradient(transparent, rgba(255,255,255,0.04));
            background-size: 24px 24px, 100% 100%;
            mix-blend-mode: screen;
            opacity: 0.7;
            transform: translateZ(20px);
            pointer-events: none;
        }

        .glare {
            position: absolute;
            inset: -30% -30%;
            background: radial-gradient(200px 120px at var(--gx,50%) var(--gy,50%), rgba(255,255,255,0.35), rgba(255,255,255,0.08) 40%, transparent 70%);
            mix-blend-mode: screen;
            filter: blur(8px);
            transform: translateZ(35px);
            pointer-events: none;
            opacity: 0.9;
            transition: opacity 120ms ease;
        }

        .holo-content {
            position: absolute;
            inset: 20px;
            transform: translateZ(30px);
            display: grid;
            gap: 8px;
        }

        .holo-tag {
            font-weight: 700;
            letter-spacing: 1.2px;
            color: #aeeaff;
            text-shadow: 0 0 14px rgba(108,241,255,0.65);
            font-size: 12px;
        }

        .holo-title {
            font-size: 18px;
            font-weight: 700;
            letter-spacing: 0.8px;
        }

        .holo-meta {
            font-size: 12px;
            color: #9fb6d6;
            letter-spacing: 0.6px;
        }

        /* Input Area */
        .input-area {
            position: absolute;
            bottom: 20px;
            left: 32px;
            right: 50%;
            display: flex;
            gap: 12px;
            align-items: flex-end;
        }

        .input-field {
            flex: 1;
            background: rgba(0,0,0,0.4);
            border: 2px solid rgba(108,241,255,0.3);
            border-radius: 12px;
            padding: 12px 16px;
            color: var(--text);
            font-family: inherit;
            font-size: 14px;
            resize: vertical;
            min-height: 45px;
            max-height: 120px;
            backdrop-filter: blur(10px);
        }

        .input-field:focus {
            outline: none;
            border-color: rgba(108,241,255,0.6);
            box-shadow: 0 0 20px rgba(108,241,255,0.2);
        }

        .input-field::placeholder {
            color: rgba(255,255,255,0.4);
        }

        .send-btn {
            background: linear-gradient(135deg, var(--accent), #0080ff);
            border: none;
            border-radius: 12px;
            width: 45px;
            height: 45px;
            color: #000;
            font-size: 18px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .send-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 0 20px rgba(108,241,255,0.4);
        }

        .file-btn {
            background: linear-gradient(135deg, #ffaa00, #ff8800);
            border: none;
            border-radius: 12px;
            width: 45px;
            height: 45px;
            color: #000;
            font-size: 16px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .file-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 0 20px rgba(255, 170, 0, 0.4);
        }

        #file-input {
            display: none;
        }

        /* Particles */
        .particle {
            position: fixed;
            width: 4px;
            height: 4px;
            background: radial-gradient(circle, #aaffff 10%, #66ffcc 70%, transparent 90%);
            border-radius: 50%;
            box-shadow: 0 0 12px rgba(108,241,255,0.9), 0 0 24px rgba(102,255,204,0.6);
            pointer-events: none;
            z-index: 999;
            opacity: 0.95;
        }

        /* Image Modal */
        .image-modal {
            display: none;
            position: fixed;
            z-index: 2000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.9);
            backdrop-filter: blur(10px);
            align-items: center;
            justify-content: center;
        }

        .image-modal img,
        .image-modal video {
            max-width: 90%;
            max-height: 90%;
            border-radius: 10px;
            box-shadow: 0 0 30px rgba(108,241,255,0.5);
            cursor: zoom-out;
        }

        .image-modal .close-btn {
            position: absolute;
            top: 20px;
            right: 20px;
            background: rgba(255, 0, 0, 0.7);
            color: white;
            border: none;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            font-size: 20px;
            cursor: pointer;
            z-index: 2001;
            transition: all 0.3s ease;
        }

        .image-modal .close-btn:hover {
            background: rgba(255, 0, 0, 0.9);
            transform: scale(1.1);
        }

        /* Responsive */
        @media (max-width: 768px) {
            .layout {
                grid-template-columns: 1fr;
            }
            .pane.right {
                display: none;
            }
            .input-area {
                right: 32px;
            }
        }
    </style>
</head>
<body>
    <div class="neural-bg"></div>
    
    <div class="layout">
        <!-- Data Stream Panel (Left) -->
        <div class="pane left">
            <div class="data-stream-header">
                <div class="stream-title">🌊 جریان داده · سیگنال‌های ورودی</div>
                <div class="stream-subtitle">Real-time Communication Stream</div>
            </div>
            
            <div class="messages-container" id="messages">
                <!-- Data cards will be added here dynamically -->
            </div>
        </div>

        <!-- Evidence Wall Panel (Right) -->
        <div class="pane right">
            <div class="evidence-header">
                <div class="evidence-title">🔮 دیوار شواهد · آرشیو هولوگرافیک</div>
                <div class="evidence-subtitle">Holographic Evidence Archive</div>
            </div>
            
            <div class="evidence-grid" id="evidence-wall">
                <!-- Holographic cards will be added here dynamically -->
            </div>
        </div>
    </div>

    <!-- Input Area -->
    <div class="input-area">
        <textarea id="input" class="input-field" placeholder="پیام خود را وارد کنید..." rows="1"></textarea>
        <input type="file" id="file-input" accept="image/*,video/*,audio/*,.pdf,.doc,.docx">
        <button class="file-btn" onclick="document.getElementById('file-input').click()">📎</button>
        <button class="send-btn" id="send-button">📡</button>
    </div>
    
    <!-- Image Modal -->
    <div id="image-modal" class="image-modal">
        <!-- محتوا توسط JavaScript اضافه می‌شود -->
    </div>

    <!-- User data and scripts -->
    <script>
        const userId = '<%= userId %>';
        const username = '<%= username %>';
        
        // Auto-resize textarea
        document.addEventListener('DOMContentLoaded', function() {
            const textarea = document.getElementById('input');
            textarea.addEventListener('input', function() {
                this.style.height = 'auto';
                this.style.height = Math.min(this.scrollHeight, 120) + 'px';
            });
        });
    </script>
    
    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/game-client-cinematic.js"></script>
</body>
</html>
