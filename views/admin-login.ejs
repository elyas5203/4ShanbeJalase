<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ورود ادمین | راز سندروم</title>
    <link rel="icon" href="/assets/favicon-detective.ico">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body { display:flex; align-items:center; justify-content:center; min-height:100vh; margin:0; background: var(--cyber-darker); color: var(--cyber-primary); font-family: 'Share Tech Mono', monospace; }
        .card { background: var(--cyber-glass); border:1px solid var(--cyber-glass-border); border-radius:16px; padding:28px 24px; width: 380px; max-width: 92vw; box-shadow: var(--cyber-shadow); }
        h1 { margin:0 0 12px; font-family:'Orbitron', monospace; font-size:20px; color: var(--cyber-primary); text-align:center; }
        .subtitle { margin:0 0 20px; font-size:12px; text-align:center; color: var(--cyber-accent); opacity:.85; }
        .error { background: rgba(255, 51, 102, 0.1); border:1px solid var(--cyber-danger); color: var(--cyber-danger); padding:10px; border-radius:10px; font-size:13px; text-align:center; margin-bottom:16px; }
        label { display:block; font-size:12px; margin-bottom:8px; color: var(--cyber-primary); }
        input[type="password"] { width:100%; padding:12px 14px; background: rgba(0,0,0,.4); border:1px solid var(--cyber-glass-border); border-radius:10px; color:#fff; box-sizing:border-box; }
        button { width:100%; padding:12px 14px; margin-top:16px; border-radius:10px; border:2px solid var(--cyber-primary); background: var(--cyber-glass); color: var(--cyber-primary); font-weight:bold; cursor:pointer; }
        button:hover { border-color: var(--cyber-accent); color:#fff; box-shadow: 0 0 20px rgba(0,255,255,.4); }
    </style>
</head>
<body>
    <div class="card">
        <h1>ورود ادمین</h1>
        <p class="subtitle">برای دسترسی به پنل ادمین، گذرواژه را وارد کنید</p>

        <% if (typeof error !== 'undefined') { %>
            <div class="error"><%= error %></div>
        <% } %>

        <form action="/gostantaniye" method="POST">
            <label for="admin-password">گذرواژه ادمین</label>
            <input type="password" id="admin-password" name="password" placeholder="" required>
            <button type="submit">ورود</button>
        </form>
    </div>
</body>
</html>
