<!-- views/arshad/terminal-arshad.ejs -->
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>سیستم کاراگاه ارشد | پرونده سندروم</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;600;700&display=swap">
  <style>
    :root {
      --primary: #1b1d1c;
      --secondary: #242623;
      --accent: #e4c491;
      --accent-glow: rgba(228, 196, 145, 0.65);
      --text-primary: #f6e2c2;
      --text-secondary: #c0ae8b;
      --success: #7bd69b;
      --warning: #e8b35a;
      --danger: #ff6b6b;
      --terminal-bg: rgba(27, 29, 28, 0.95);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Vazirmatn', 'Segoe UI', 'Tahoma', 'Geneva', 'Verdana', sans-serif;
    }

    body {
      background: radial-gradient(circle at center, #26231c 0%, #1b1d1c 45%, #11110f 100%);
      color: var(--text-primary);
      min-height: 100vh;
      overflow: hidden;
      position: relative;
    }

    body::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background:
        radial-gradient(circle at 20% 30%, rgba(0, 243, 255, 0.1) 0%, transparent 50%),
        radial-gradient(circle at 80% 70%, rgba(255, 46, 109, 0.1) 0%, transparent 50%);
      z-index: -1;
    }

    /* استایل کانتینر اصلی */
    .cyber-terminal {
      display: flex;
      flex-direction: column;
      max-width: 1400px;
      height: 100vh;
      margin: 0 auto;
      background: var(--terminal-bg);
      border: 1px solid rgba(228, 196, 145, 0.22);
      box-shadow:
        0 0 30px rgba(228, 196, 145, 0.18),
        inset 0 0 30px rgba(228, 196, 145, 0.08);
      position: relative;
      overflow: hidden;
    }

    .cyber-terminal::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background:
        linear-gradient(90deg, transparent 50%, rgba(228, 196, 145, 0.04) 50%),
        linear-gradient(transparent 50%, rgba(228, 196, 145, 0.04) 50%);
      background-size: 10px 10px;
      z-index: 0;
      pointer-events: none;
    }

    /* هدر سایبری */
    .cyber-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 15px 25px;
      background: rgba(27, 29, 28, 0.9);
      border-bottom: 1px solid var(--accent);
      box-shadow: 0 0 15px var(--accent-glow);
      position: relative;
      z-index: 10;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 1.5rem;
      font-weight: bold;
      color: var(--accent);
      text-shadow: 0 0 10px var(--accent-glow);
    }

    .logo i {
      font-size: 1.8rem;
      animation: pulse 3s infinite;
    }

    .status-grid {
      display: grid;
      grid-template-columns: repeat(3, auto);
      gap: 20px;
    }

    .status-item {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .status-label {
      font-size: 0.7rem;
      color: var(--text-secondary);
      margin-bottom: 5px;
    }

    .status-value {
      font-size: 0.9rem;
      font-weight: bold;
      color: var(--success);
      text-shadow: 0 0 5px var(--success);
    }

    .user-profile {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .hologram-avatar {
      width: 45px;
      height: 45px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--accent) 0%, var(--danger) 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
      box-shadow: 0 0 15px var(--accent-glow);
    }

    .hologram-avatar::before {
      content: '';
      position: absolute;
      width: 100%;
      height: 100%;
      background: linear-gradient(45deg, transparent 30%, rgba(255,255,255,0.2) 50%, transparent 70%);
      animation: hologram 4s infinite linear;
    }

    /* بخش اصلی چت */
    .chat-hub {
      display: flex;
      flex: 1;
      overflow: hidden;
      position: relative;
      z-index: 1;
    }

    /* پنل کناری */
    .cyber-sidebar {
      width: 240px;
      background: rgba(27, 29, 28, 0.8);
      border-left: 1px solid rgba(228, 196, 145, 0.25);
      display: flex;
      flex-direction: column;
      padding: 14px;
      gap: 12px;
      overflow-y: auto; /* بازگشت اسکرول */
    }

    .panel {
      background: rgba(27, 29, 28, 0.7);
      border: 1px solid rgba(228, 196, 145, 0.26);
      border-radius: 8px;
      padding: 12px;
      box-shadow: 0 0 10px rgba(228, 196, 145, 0.06);
    }

    .panel-header {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 10px;
      color: var(--accent);
      font-size: 0.9rem;
    }

    .case-progress {
      margin-top: 10px;
    }

    .case-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .case-item {
      padding: 10px 12px;
      border-radius: 8px;
      background: rgba(27, 29, 28, 0.8);
      border: 1px solid rgba(228, 196, 145, 0.18);
    }

    .case-item.active {
      border-color: var(--accent);
      box-shadow: 0 0 10px var(--accent-glow);
    }

    .case-item.locked {
      opacity: 0.7;
      border-style: dashed;
    }

    .case-title {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 0.9rem;
      margin-bottom: 4px;
    }

    .case-title i {
      margin-left: 6px;
      color: var(--text-secondary);
    }

    .case-meta {
      font-size: 0.78rem;
      color: var(--text-secondary);
    }

    .case-lock-pill {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 2px 8px;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.14);
      font-size: 0.7rem;
      color: var(--text-secondary);
    }

    .progress-bar {
      height: 6px;
      background: rgba(228, 196, 145, 0.18);
      border-radius: 3px;
      overflow: hidden;
      margin-bottom: 5px;
    }

    .progress-fill {
      height: 100%;
      background: linear-gradient(90deg, rgba(228,196,145,0.7), rgba(228,196,145,1));
      border-radius: 3px;
      width: 80%;
      box-shadow: 0 0 8px var(--accent-glow);
    }

    .tools-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }

    .tool-btn {
      background: rgba(228, 196, 145, 0.08);
      border: 1px solid rgba(228, 196, 145, 0.26);
      border-radius: 6px;
      padding: 10px;
      color: var(--text-primary);
      cursor: pointer;
      transition: all 0.3s;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 5px;
      font-size: 0.8rem;
    }

    .tool-btn:hover {
      background: rgba(228, 196, 145, 0.18);
      box-shadow: 0 0 10px var(--accent-glow);
      transform: translateY(-2px);
    }

    /* منطقه چت */
    .cyber-chat {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      position: relative;
    }

    .chat-display {
      flex: 1;
      padding: 20px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 20px;
      position: relative;
    }

    /* اسکرول‌بار طلایی برای چت */
    .chat-display { scrollbar-width: thin; scrollbar-color: #c8a56b rgba(228,196,145,0.08); }
    .chat-display::-webkit-scrollbar { width: 10px; }
    .chat-display::-webkit-scrollbar-track { background: rgba(228,196,145,0.08); border-left: 1px solid rgba(228,196,145,0.12); }
    .chat-display::-webkit-scrollbar-thumb { background: linear-gradient(180deg, #e4c491, #c8a56b); border-radius: 8px; box-shadow: 0 0 10px rgba(228,196,145,0.4); }
    .chat-display::-webkit-scrollbar-thumb:hover { background: linear-gradient(180deg, #f0d7a8, #d1b07a); }

    /* اسکرول‌بار سایدبار و صفحه به تم طلایی (رفع اسکرول سفید) */
    html { scrollbar-width: thin; scrollbar-color: #c8a56b rgba(228,196,145,0.08); }
    html::-webkit-scrollbar { width: 12px; }
    html::-webkit-scrollbar-track { background: rgba(228,196,145,0.06); border-left: 1px solid rgba(228,196,145,0.12); }
    html::-webkit-scrollbar-thumb { background: linear-gradient(180deg, #e4c491, #c8a56b); border-radius: 10px; box-shadow: 0 0 10px rgba(228,196,145,0.35); }
    html::-webkit-scrollbar-thumb:hover { background: linear-gradient(180deg, #f0d7a8, #d1b07a); }
    body { scrollbar-width: thin; scrollbar-color: #c8a56b rgba(228,196,145,0.08); }
    body::-webkit-scrollbar { width: 12px; }
    body::-webkit-scrollbar-track { background: rgba(228,196,145,0.06); border-left: 1px solid rgba(228,196,145,0.12); }
    body::-webkit-scrollbar-thumb { background: linear-gradient(180deg, #e4c491, #c8a56b); border-radius: 10px; box-shadow: 0 0 10px rgba(228,196,145,0.35); }
    body::-webkit-scrollbar-thumb:hover { background: linear-gradient(180deg, #f0d7a8, #d1b07a); }

    .cyber-sidebar { scrollbar-width: thin; scrollbar-color: #c8a56b rgba(228,196,145,0.08); }
    .cyber-sidebar::-webkit-scrollbar { width: 10px; }
    .cyber-sidebar::-webkit-scrollbar-track { background: rgba(228,196,145,0.08); border-left: 1px solid rgba(228,196,145,0.12); }
    .cyber-sidebar::-webkit-scrollbar-thumb { background: linear-gradient(180deg, #e4c491, #c8a56b); border-radius: 8px; box-shadow: 0 0 10px rgba(228,196,145,0.4); }

    #messages {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .message {
      max-width: 66%;
      padding: 15px 20px;
      border-radius: 12px;
      position: relative;
      animation: messageAppear 0.4s ease-out;
      backdrop-filter: blur(5px);
    }
    /* پیام‌های صوتی افقی‌تر و عریض‌تر (مانند پنل ادمین) */
    .audio-msg { width: 100%; max-width: none !important; }
    .audio-msg .message-header { margin-bottom: 8px; }
    .audio-msg .message-content { width: 100%; }
    .audio-msg .media-card { width: 100%; max-width: none; padding: 10px 12px; }
    .audio-msg .media-audio { width: 100%; height: 64px; }

    @keyframes messageAppear {
      0% { opacity: 0; transform: translateY(20px) scale(0.95); }
      100% { opacity: 1; transform: translateY(0) scale(1); }
    }

    .detective-message {
      align-self: flex-start;
      background: rgba(228, 196, 145, 0.10);
      border: 1px solid rgba(228, 196, 145, 0.35);
      border-bottom-left-radius: 4px;
      box-shadow: 0 0 15px rgba(228, 196, 145, 0.12);
    }

    .user-message {
      align-self: flex-end;
      background: linear-gradient(135deg, rgba(228, 196, 145, 0.16) 0%, rgba(228, 196, 145, 0.26) 100%);
      border: 1px solid rgba(228, 196, 145, 0.4);
      border-bottom-right-radius: 4px;
      box-shadow: 0 0 15px rgba(228, 196, 145, 0.18);
    }

    .message-header {
      display: flex;
      justify-content: space-between;
      margin-bottom: 8px;
      font-size: 0.8rem;
    }

    .message-sender {
      color: var(--accent);
      font-weight: bold;
    }

    .message-time {
      color: var(--text-secondary);
    }

    .message-content {
      line-height: 1.5;
      word-wrap: break-word;
      overflow-wrap: anywhere;
      white-space: pre-wrap;
    }

    /* کارت رسانه‌ای برای ویس/ویدئو/عکس */
    .media-card {
      background: rgba(27, 29, 28, 0.82);
      border: 1px solid rgba(228, 196, 145, 0.35);
      border-radius: 10px;
      padding: 12px;
      box-shadow: 0 0 10px rgba(228, 196, 145, 0.08);
      max-width: 600px; /* عریض‌تر برای نمایش بهتر پلی */
    }
    .media-card .media-title { color: var(--text-secondary); font-size: 0.8rem; margin-bottom: 6px; }
    .media-audio { width: 100%; height: 52px; }
    .media-video { width: 100%; max-height: 320px; border-radius: 8px; border: 1px solid rgba(228,196,145,0.25); background: #000; cursor: zoom-in; }
    .media-image { width: 100%; border-radius: 8px; border: 1px solid rgba(228,196,145,0.25); cursor: zoom-in; }
    .media-actions { margin-top: 8px; display: flex; gap: 12px; }
    .media-actions a { color: var(--accent); font-size: 0.85rem; text-decoration: underline; }

    .typing-indicator {
      align-self: flex-start;
      background: rgba(27, 29, 28, 0.7);
      padding: 15px 20px;
      border-radius: 12px;
      border-bottom-left-radius: 4px;
      display: flex;
      gap: 8px;
      border: 1px solid rgba(228, 196, 145, 0.35);
      box-shadow: 0 0 10px rgba(228, 196, 145, 0.1);
    }

    .typing-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--accent);
      animation: typingAnimation 1.4s infinite ease-in-out;
      box-shadow: 0 0 5px var(--accent-glow);
    }

    .typing-dot:nth-child(1) { animation-delay: 0s; }
    .typing-dot:nth-child(2) { animation-delay: 0.2s; }
    .typing-dot:nth-child(3) { animation-delay: 0.4s; }

    /* ورودی پیام */
    .message-input-panel {
      padding: 16px;
      background: rgba(27, 29, 28, 0.9);
      border-top: 1px solid rgba(228, 196, 145, 0.26);
      box-shadow: 0 -5px 15px rgba(0, 0, 0, 0.3);
    }

    .input-container {
      display: flex;
      gap: 15px;
    }

    .cyber-input {
      flex: 1;
      padding: 12px 16px;
      border: 1px solid rgba(228, 196, 145, 0.35);
      border-radius: 8px;
      background: rgba(27, 29, 28, 0.7);
      color: var(--text-primary);
      font-size: 0.95rem;
      outline: none;
      transition: all 0.3s;
      box-shadow: 0 0 10px rgba(228, 196, 145, 0.08);
      resize: none; /* ثابت نگه داشتن ارتفاع */
      max-height: 120px;
    }

    .cyber-input:focus {
      border-color: var(--accent);
      box-shadow: 0 0 15px var(--accent-glow);
    }

    .send-btn {
      padding: 15px 25px;
      background: linear-gradient(135deg, var(--accent) 0%, var(--success) 100%);
      color: var(--primary);
      border: none;
      border-radius: 8px;
      cursor: pointer;
      font-weight: bold;
      transition: all 0.3s;
      box-shadow: 0 0 15px rgba(0, 243, 255, 0.3);
    }

    .send-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 0 20px rgba(0, 243, 255, 0.5);
    }

    /* ابزارهای فعال */
    .active-tool {
      background: rgba(0, 243, 255, 0.3) !important;
      border-color: var(--accent) !important;
      box-shadow: 0 0 15px var(--accent-glow) !important;
    }

    /* پنل ابزار فعال */
    .tool-panel {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 90%;
      height: 85%;
      background: rgba(10, 10, 22, 0.95);
      border: 2px solid var(--accent);
      border-radius: 12px;
      box-shadow: 0 0 30px var(--accent-glow);
      z-index: 100;
      display: none;
      flex-direction: column;
      overflow: hidden;
    }

    .tool-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 15px 20px;
      background: rgba(21, 21, 40, 0.9);
      border-bottom: 1px solid var(--accent);
    }

    .tool-title {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 1.2rem;
      color: var(--accent);
    }

    .close-tool {
      background: none;
      border: none;
      color: var(--text-primary);
      font-size: 1.5rem;
      cursor: pointer;
      transition: all 0.3s;
    }

    .close-tool:hover {
      color: var(--danger);
      transform: scale(1.1);
    }

    .tool-content {
      flex: 1;
      padding: 20px;
      overflow-y: auto;
    }
    /* اسکرول طلایی برای پنل ابزار */
    .tool-content { scrollbar-width: thin; scrollbar-color: #c8a56b rgba(228,196,145,0.08); }
    .tool-content::-webkit-scrollbar { width: 10px; }
    .tool-content::-webkit-scrollbar-track { background: rgba(228,196,145,0.08); border-left: 1px solid rgba(228,196,145,0.12); }
    .tool-content::-webkit-scrollbar-thumb { background: linear-gradient(180deg, #e4c491, #c8a56b); border-radius: 8px; box-shadow: 0 0 10px rgba(228,196,145,0.4); }
    .tool-content::-webkit-scrollbar-thumb:hover { background: linear-gradient(180deg, #f0d7a8, #d1b07a); }

    /* کوچک‌سازی کلی سایدبار برای جا شدن محتوا */
    .cyber-sidebar .panel { font-size: 0.92rem; }
    .cyber-sidebar .case-meta { font-size: 0.76rem; }
    .cyber-sidebar .panel-header { font-size: 0.86rem; }

    /* جدول اطلاعات */
    .info-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 15px;
    }

    .info-table th, .info-table td {
      border: 1px solid rgba(0, 243, 255, 0.3);
      padding: 10px;
      text-align: right;
    }

    .info-table th {
      background: rgba(0, 243, 255, 0.2);
      color: var(--accent);
    }

    .info-table tr:nth-child(even) {
      background: rgba(21, 21, 40, 0.5);
    }

    /* کارت اطلاعات */
    .info-card {
      background: rgba(21, 21, 40, 0.7);
      border: 1px solid rgba(0, 243, 255, 0.3);
      border-radius: 8px;
      padding: 15px;
      margin-bottom: 15px;
    }

    .info-card h4 {
      color: var(--accent);
      margin-bottom: 10px;
    }

    /* گالری تصاویر مدارک */
    .evidence-gallery {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 15px;
      margin-top: 15px;
    }

    .evidence-item {
      background: rgba(21, 21, 40, 0.8);
      border: 1px solid rgba(0, 243, 255, 0.3);
      border-radius: 8px;
      overflow: hidden;
      transition: all 0.3s;
      cursor: pointer;
    }

    .evidence-item:hover {
      transform: translateY(-5px);
      box-shadow: 0 0 15px var(--accent-glow);
      border-color: var(--accent);
    }

    .evidence-image {
      width: 100%;
      height: 150px;
      object-fit: cover;
      border-bottom: 1px solid rgba(0, 243, 255, 0.3);
    }

    .evidence-caption {
      padding: 10px;
      font-size: 0.9rem;
      text-align: center;
      color: var(--text-primary);
    }

    /* مدال نمایش تصویر بزرگ */
    .image-modal {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.8);
      display: none;
      justify-content: center;
      align-items: center;
      z-index: 1000;
    }

    .modal-content {
      max-width: 90%;
      max-height: 90%;
      position: relative;
    }

    .modal-image {
      max-width: 100%;
      max-height: 100%;
      border: 2px solid var(--accent);
      border-radius: 8px;
      box-shadow: 0 0 30px var(--accent-glow);
    }

    .close-modal {
      position: absolute;
      top: -40px;
      right: 0;
      background: none;
      border: none;
      color: var(--text-primary);
      font-size: 2rem;
      cursor: pointer;
    }

    /* انیمیشن‌ها */
    @keyframes pulse {
      0% { opacity: 0.7; }
      50% { opacity: 1; }
      100% { opacity: 0.7; }
    }

    @keyframes hologram {
      0% { transform: translateX(-100%) rotate(45deg); }
      100% { transform: translateX(100%) rotate(45deg); }
    }

    @keyframes typingAnimation {
      0%, 60%, 100% { transform: translateY(0); }
      30% { transform: translateY(-5px); }
    }

    /* واکنش‌گرا */
    @media (max-width: 1024px) {
      .cyber-sidebar {
        width: 220px;
      }

      .status-grid {
        grid-template-columns: repeat(2, auto);
        gap: 15px;
      }

      .evidence-gallery {
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      }
    }

    @media (max-width: 768px) {
      .cyber-sidebar {
        display: none;
      }

      .message {
        max-width: 90%;
      }

      .status-grid {
        display: none;
      }

      .tool-panel {
        width: 95%;
        height: 90%;
      }

      .evidence-gallery {
        grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
      }
    }
  </style>
</head>
<body>
  <div class="cyber-terminal">
    <!-- هدر سایبری -->
    <div class="cyber-header">
      <div class="logo">
        <i class="fas fa-user-secret"></i>
        <span>کاراگاه ارشد | پرونده سندروم</span>
      </div>

      <div class="status-grid">
        <div class="status-item">
          <div class="status-label">وضعیت پرونده</div>
          <div class="status-value">فعال</div>
        </div>
